<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>WeCharge Control | FIAP × GoodWe</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#0B0D18; --panel:#171B2E; --panel-2:#1E2338;
    --red:#E4293D; --pink:#EC1E67; --green:#34D399; --amber:#F4B740; --blue:#4C8DFF;
    --text:#F4F5F9; --text-dim:#9096B0; --line:#2A2F48;
  }
  *{box-sizing:border-box;}
  body{
    margin:0; min-height:100vh; padding:0;
    background: radial-gradient(circle at 15% -5%, rgba(228,41,61,0.08), transparent 40%),
                radial-gradient(circle at 85% 10%, rgba(236,30,103,0.08), transparent 40%),
                #07080F;
    font-family:'Inter', sans-serif; color:var(--text);
  }
  .app-wrap{ display:flex; min-height:100vh; max-width:1800px; margin:0 auto; padding:28px; gap:56px; align-items:flex-start; justify-content:center; }

  /* ============ ADMIN (esquerda) — painel flutuante, com respiro ao redor ============ */
  .admin-col{
    flex:1 1 auto; min-width:0; max-width:1120px; padding:14px 18px;
    background:var(--bg); border:1px solid var(--line); border-radius:22px;
    box-shadow:0 30px 70px -30px rgba(0,0,0,.6);
    transition:background .3s;
  }
  .admin-col.visao-mode{ background:#0E1120; }

  .admin-window-bar{ display:flex; align-items:center; gap:6px; margin-bottom:16px; }
  .admin-window-dot{ width:11px; height:11px; border-radius:50%; }
  .admin-window-dot.red{ background:#FF5F57; }
  .admin-window-dot.yellow{ background:#FEBC2E; }
  .admin-window-dot.green{ background:#28C840; }
  .admin-window-title{ margin-left:10px; font-size:11px; color:var(--text-dim); font-family:'Space Grotesk',sans-serif; font-weight:600; letter-spacing:.03em; }

  .dash-grid{ display:grid; grid-template-columns:1.6fr 1fr; gap:16px; align-items:stretch; }
  .dash-col-main, .dash-col-side{ display:flex; flex-direction:column; }
  .dash-col-side .a-card{ flex:1; display:flex; flex-direction:column; justify-content:center; }
  @media (max-width:1150px){ .dash-grid{ grid-template-columns:1fr; } }

  .a-card-title-row{ display:flex; align-items:center; justify-content:space-between; margin-bottom:14px; }
  .status-pill{ display:inline-flex; align-items:center; gap:6px; font-size:10.5px; font-family:'Space Grotesk',sans-serif; font-weight:600; color:var(--green); background:rgba(52,211,153,.12); border:1px solid rgba(52,211,153,.3); padding:4px 11px; border-radius:999px; }
  .status-pill.mini{ font-size:9.5px; padding:3px 9px; }
  .status-pill-dot{ width:6px; height:6px; border-radius:50%; background:currentColor; }

  .grid4{ display:grid; grid-template-columns:repeat(4,1fr); gap:5px; margin-bottom:6px; }
  @media (max-width:640px){ .grid4{ grid-template-columns:repeat(2,1fr); } }
  .stat-box{ background:var(--panel-2); border:1px solid var(--line); border-radius:9px; padding:7px 6px; text-align:center; }
  .sb-label{ font-size:8.5px; color:var(--text-dim); text-transform:uppercase; letter-spacing:.04em; font-family:'Space Grotesk',sans-serif; font-weight:600; margin-bottom:10px; }
  .sb-val{ font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:12px; }
  .sb-val.pos{ color:var(--green); }

  .cap-bar-header{ display:flex; justify-content:space-between; align-items:center; font-size:11px; color:var(--text-dim); margin-bottom:7px; }
  .cap-bar-header b{ color:var(--text); font-family:'Space Grotesk',sans-serif; font-size:12.5px; }
  .cap-bar-sub-split{ text-align:center; font-size:11px; color:var(--text-dim); margin-top:8px; }
  .cap-bar-sub-split .plus{ opacity:.5; margin:0 4px; }

  .section-title{ font-size:10px; text-transform:uppercase; letter-spacing:.05em; color:var(--text-dim); margin:1px 0 6px; padding:0; background:none; border:none; }
  .grid3-energy{ display:grid; grid-template-columns:1fr 1fr 1fr; gap:7px; margin-bottom:7px; }
  @media (max-width:900px){ .grid3-energy{ grid-template-columns:1fr; } }
  .mini-card{ padding:9px; display:flex; flex-direction:column; }
  .mini-card-title{ font-size:10px; color:var(--text-dim); font-family:'Space Grotesk',sans-serif; font-weight:600; margin-bottom:12px; }
  .mini-card-title-row{ display:flex; align-items:center; justify-content:space-between; margin-bottom:12px; }
  .mini-card-big{ font-family:'Space Grotesk',sans-serif; font-weight:800; font-size:15px; }
  .mini-card-big.pos{ color:var(--green); }
  .mini-card-sub{ font-size:12px; color:var(--text-dim); margin-top:4px; }
  .solar-sparkline{ width:100%; height:64px; margin-top:8px; }
  .sparkline-axis{ display:flex; justify-content:space-between; font-size:8px; color:var(--text-dim); opacity:.6; margin-top:2px; }

  .flow-diagram-mini{ display:flex; flex-direction:column; align-items:center; gap:8px; margin-top:10px; }
  .flow-row-mini{ display:flex; align-items:center; gap:14px; }
  .flow-node-mini{ text-align:center; min-width:56px; }
  .flow-node-mini.wide{ min-width:56px; }
  .fnm-ic{ font-size:17px; margin-bottom:4px; }
  .fnm-txt{ font-size:9.5px; color:var(--text-dim); line-height:1.6; }
  .fnm-txt b{ color:var(--text); font-family:'Space Grotesk',sans-serif; font-size:12px; }
  .fnm-txt b.pos{ color:var(--green); }
  .flow-hub{ width:34px; height:34px; border-radius:50%; background:var(--bg); border:1.5px solid var(--line); display:flex; align-items:center; justify-content:center; font-size:14px; flex-shrink:0; color:var(--red); box-shadow:0 0 12px -3px rgba(228,41,61,.4); }
  .flow-arrow-mini{ font-size:15px; font-weight:700; }
  .flow-arrow-mini.blue{ color:var(--blue); }
  .flow-arrow-mini.amber{ color:var(--amber); }
  .flow-arrow-mini.down{ color:var(--green); margin:0; }

  .sessions-table-wrap{ overflow-x:auto; }
  .sessions-table{ width:100%; border-collapse:collapse; font-size:13px; }
  .sessions-table th{ text-align:left; font-family:'Space Grotesk',sans-serif; font-size:8.5px; text-transform:uppercase; letter-spacing:.04em; color:var(--text-dim); padding:6px 8px; border-bottom:1px solid var(--line); }
  .sessions-table td{ padding:5px 7px; border-bottom:1px solid var(--line); vertical-align:middle; }
  .sessions-table tr:last-child td{ border-bottom:none; }
  .sessions-table .st-vaga-num{ font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:13px; }
  .sessions-table .st-vaga-sub{ font-size:9px; color:var(--text-dim); }
  .sessions-table .st-badge{ font-size:9.5px; font-family:'Space Grotesk',sans-serif; font-weight:600; padding:3px 9px; border-radius:999px; display:inline-flex; align-items:center; gap:4px; }
  .sessions-table .st-badge.charging{ background:rgba(52,211,153,.14); color:var(--green); }
  .sessions-table .st-badge.paused{ background:rgba(228,41,61,.14); color:#FF6B7D; }
  .sessions-table .st-badge.waiting{ background:rgba(76,141,255,.14); color:var(--blue); }
  .sessions-table .st-badge.done{ background:rgba(76,141,255,.14); color:var(--blue); }
  .st-progress-track{ width:90px; height:6px; border-radius:4px; background:var(--bg); border:1px solid var(--line); overflow:hidden; display:inline-block; vertical-align:middle; margin-right:8px; }
  .st-progress-fill{ height:100%; background:linear-gradient(90deg,var(--green),#26B583); }

  .ai-summary-caption{ font-size:11px; color:var(--text-dim); line-height:1.55; margin-bottom:14px; }
  .ai-summary-title{ font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:11px; color:var(--text-dim); margin-bottom:8px; }
  .ai-summary-list{ display:flex; flex-direction:column; gap:8px; }
  .ai-summary-item{ display:flex; align-items:center; gap:8px; font-size:11.5px; }
  .ai-summary-item .cm{ color:var(--green); font-weight:700; flex-shrink:0; }

  .dash-footer{ display:flex; align-items:center; justify-content:flex-end; margin-top:14px; }
  .dash-footer-updated{ font-size:10.5px; color:var(--text-dim); }

  .admin-header{ display:flex; align-items:center; justify-content:space-between; margin-bottom:10px; }
  .admin-brand{ display:flex; align-items:center; gap:9px; }
  .admin-brand-word{ font-family:'Space Grotesk',sans-serif; font-weight:800; font-size:22px; }
  .admin-brand-word .accent{ background:linear-gradient(135deg,var(--red),var(--pink)); -webkit-background-clip:text; background-clip:text; color:transparent; }
  .admin-brand-sub{ font-size:12px; color:var(--text-dim); text-transform:uppercase; letter-spacing:.1em; font-family:'Space Grotesk',sans-serif; }
  .admin-online{ display:flex; align-items:center; gap:6px; font-size:11px; color:var(--green); font-family:'Space Grotesk',sans-serif; font-weight:600; }
  .admin-online .dot{ width:6px;height:6px;border-radius:50%; background:var(--green); box-shadow:0 0 0 3px rgba(52,211,153,.18); animation:blink 2s ease-in-out infinite; }
  @keyframes blink{ 0%,100%{opacity:1;} 50%{opacity:.4;} }
  .admin-place-row{ display:flex; align-items:center; justify-content:space-between; margin-bottom:18px; }
  .admin-place{ font-size:16px; color:var(--text-dim); font-weight:600; }
  .admin-partner{ display:flex; align-items:center; gap:8px; font-size:13px; color:var(--text-dim); font-family:'Space Grotesk',sans-serif; font-weight:600; }
  .admin-partner-x{ opacity:.6; font-weight:400; }
  .goodwe-logo{ height:16px; filter:brightness(0) saturate(100%) invert(20%) sepia(80%) saturate(3000%) hue-rotate(340deg) brightness(95%) contrast(95%); }

  .admin-nav{ display:flex; gap:6px; margin-bottom:14px; background:var(--panel); border:1px solid var(--line); border-radius:12px; padding:4px; }
  .admin-nav-item{ flex:1; text-align:center; padding:9px 6px; border-radius:9px; font-family:'Space Grotesk',sans-serif; font-size:11.5px; font-weight:600; color:var(--text-dim); cursor:pointer; }
  .admin-nav-item.active{ background:linear-gradient(135deg,var(--red),var(--pink)); color:#fff; }

  .grid2{ display:grid; grid-template-columns:1fr 1fr; gap:14px; }
  .grid3{ display:grid; grid-template-columns:1fr 1fr 1fr; gap:10px; }
  .a-card{ background:var(--panel); border:1px solid var(--line); border-radius:11px; padding:9px; margin-bottom:7px; }
  .a-card-title{ font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:13px; display:flex; align-items:center; gap:8px; margin-bottom:14px; text-transform:uppercase; letter-spacing:.04em; color:var(--text-dim); }
  .a-stat{ background:var(--panel-2); border:1px solid var(--line); border-radius:12px; padding:12px; text-align:center; }
  .a-stat .al{ font-size:9.5px; color:var(--text-dim); margin-bottom:5px; text-transform:uppercase; letter-spacing:.04em; font-family:'Space Grotesk',sans-serif; }
  .a-stat .av{ font-family:'Space Grotesk',sans-serif; font-weight:800; font-size:20px; }
  .a-stat .av.neg{ color:#FF6B7D; }
  .a-stat .av.pos{ color:var(--green); }

  .a-bar-track{ height:16px; border-radius:9px; background:var(--bg); border:1px solid var(--line); overflow:hidden; margin:8px 0; }
  .demand-indicator{ display:flex; align-items:center; justify-content:center; gap:6px; font-size:11px; color:var(--text-dim); margin-top:8px; font-family:'Space Grotesk',sans-serif; font-weight:600; }
  .a-bar-fill{ height:100%; background:linear-gradient(90deg,var(--green),#26B583); transition:width .5s ease; }
  .a-bar-fill.off{ background:linear-gradient(90deg,var(--blue),#3A6FD9); }

  .solar-toggle-card{ display:flex; align-items:center; justify-content:space-between; background:var(--panel-2); border:1px solid var(--line); border-radius:13px; padding:14px 16px; }
  .solar-transition-notice{ display:flex; align-items:center; justify-content:space-between; gap:8px; background:rgba(76,141,255,.08); border:1px solid rgba(76,141,255,.28); border-radius:11px; padding:10px 13px; margin-top:10px; font-size:11.5px; color:var(--text-dim); line-height:1.5; }
  .solar-aviso-close{ cursor:pointer; color:var(--text-dim); font-size:13px; flex-shrink:0; }
  .solar-aviso-close:hover{ color:var(--text); }
  .reserva-solar-top{ display:flex; justify-content:space-between; align-items:center; font-size:11.5px; color:var(--text-dim); margin-bottom:8px; }
  .reserva-solar-top b{ color:var(--amber); font-family:'Space Grotesk',sans-serif; font-size:14px; }
  .reserva-solar-note{ font-size:10px; color:var(--text-dim); text-align:center; margin-top:10px; line-height:1.6; opacity:.85; }
  .reserva-solar-note b{ color:var(--text); font-family:'Space Grotesk',sans-serif; }

  /* ---------- Bateria visual da reserva solar (admin + usuário) ---------- */
  .kw-kwh-caption{ font-size:10px; color:var(--text-dim); margin-top:10px; line-height:1.5; }
  .kw-kwh-caption b{ color:var(--amber); font-family:'Space Grotesk',sans-serif; }
  .kw-kwh-caption.center{ text-align:center; margin-top:12px; }
  .kw-kwh-caption .kw-kwh-sep{ opacity:.5; margin:0 2px; }

  .battery-visual-row{ display:flex; flex-direction:column; align-items:center; justify-content:center; gap:8px; padding:6px 0 4px; width:100%; }
  .battery-shape{
    width:78px; height:34px; border:2.5px solid var(--line); border-radius:8px;
    position:relative; padding:3px; background:var(--bg); flex-shrink:0;
    display:flex; align-items:center;
  }
  .battery-shape::after{
    content:''; position:absolute; right:-8px; top:50%; transform:translateY(-50%);
    width:6px; height:14px; background:var(--line); border-radius:0 3px 3px 0;
  }
  .battery-fill{ height:100%; border-radius:4px; transition:width .7s ease, background-color .4s ease; background:var(--green); }
  .battery-fill.level-high{ background:linear-gradient(90deg,#34D399,#26B583); }
  .battery-fill.level-mid{ background:linear-gradient(90deg,#F4B740,#D99A2B); }
  .battery-fill.level-low{ background:linear-gradient(90deg,#E4293D,#C41F32); }
  .battery-fill.level-empty{ background:var(--line); }
  .battery-pct-big{ font-family:'Space Grotesk',sans-serif; font-weight:800; font-size:30px; transition:color .4s ease; }
  .battery-pct-big.level-high{ color:var(--green); }
  .battery-pct-big.level-mid{ color:var(--amber); }
  .battery-pct-big.level-low{ color:var(--red); }
  .battery-pct-big.level-empty{ color:var(--text-dim); }

  .battery-shape-mini{ width:52px; height:22px; border:2px solid var(--line); border-radius:6px; position:relative; padding:2px; background:var(--bg); flex-shrink:0; display:flex; align-items:center; }
  .battery-shape-mini::after{ content:''; position:absolute; right:-5px; top:50%; transform:translateY(-50%); width:4px; height:10px; background:var(--line); border-radius:0 2px 2px 0; }
  .battery-fill-mini{ height:100%; border-radius:3px; transition:width .7s ease, background-color .4s ease; }
  .battery-fill-mini.level-high{ background:linear-gradient(90deg,#34D399,#26B583); }
  .battery-fill-mini.level-mid{ background:linear-gradient(90deg,#F4B740,#D99A2B); }
  .battery-fill-mini.level-low{ background:linear-gradient(90deg,#E4293D,#C41F32); }
  .battery-fill-mini.level-empty{ background:var(--line); }
  .u-mini-reserva-row{ display:flex; align-items:center; gap:8px; justify-content:center; font-size:10px; color:var(--text-dim); margin-bottom:8px; }
  .u-mini-reserva-row b{ color:var(--text); font-family:'Space Grotesk',sans-serif; }
  .u-fonte-split{ display:flex; justify-content:space-between; font-size:10.5px; color:var(--text-dim); padding:9px 11px; }
  .u-fonte-split b{ color:var(--text); font-family:'Space Grotesk',sans-serif; }
  .u-reserva-solar-card{ background:var(--panel-2); border:1px solid var(--line); border-radius:13px; padding:13px; margin-top:10px; }
  .u-reserva-solar-title{ font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:11.5px; color:var(--text-dim); text-transform:uppercase; letter-spacing:.05em; margin-bottom:6px; text-align:center; }
  .solar-toggle-info{ display:flex; align-items:center; gap:11px; }
  .solar-ic{ font-size:22px; }
  .solar-status{ font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:13px; }
  .solar-status.on{ color:var(--green); }
  .solar-status.off{ color:var(--text-dim); }
  .solar-sub{ font-size:10.5px; color:var(--text-dim); }
  .btn{ border:none; cursor:pointer; font-family:'Space Grotesk',sans-serif; font-weight:600; border-radius:10px; padding:10px 16px; font-size:12px; }
  .btn-primary{ background:linear-gradient(135deg,var(--red),var(--pink)); color:#fff; }
  .btn-primary:hover{ filter:brightness(1.08); }
  .btn-primary:disabled{ opacity:.35; cursor:not-allowed; }
  .btn-ghost{ background:transparent; border:1px solid var(--line); color:var(--text-dim); }
  .btn-ghost:hover{ border-color:#3A4066; color:var(--text); }
  .btn-block{ width:100%; }

  .session-row{ background:var(--panel-2); border:1px solid var(--line); border-radius:13px; padding:14px 16px; margin-bottom:10px; }
  .session-top{ display:flex; justify-content:space-between; align-items:center; margin-bottom:8px; }
  .session-name{ font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:13.5px; }
  .session-badge{ font-size:9.5px; font-family:'Space Grotesk',sans-serif; font-weight:600; padding:3px 9px; border-radius:999px; }
  .session-badge.charging{ background:rgba(52,211,153,.14); color:var(--green); }
  .session-badge.waiting{ background:rgba(76,141,255,.14); color:var(--blue); }
  .session-badge.paused{ background:rgba(228,41,61,.14); color:#FF6B7D; }
  .session-stats{ display:flex; gap:8px; }
  .session-stat{ flex:1; text-align:center; background:var(--bg); border:1px solid var(--line); border-radius:9px; padding:7px 6px; }
  .session-stat .sl{ font-size:8.5px; color:var(--text-dim); margin-bottom:2px; }
  .session-stat .sv{ font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:12px; }
  .session-empty{ text-align:center; padding:20px; color:var(--text-dim); font-size:12px; }

  .arrival-btn-card{ display:flex; align-items:center; justify-content:space-between; background:var(--panel-2); border:1px dashed #3A4066; border-radius:13px; padding:13px 16px; }
  .ev2-detected-box{ background:linear-gradient(135deg, rgba(76,141,255,.12), rgba(76,141,255,.02)); border:1px solid rgba(76,141,255,.35); border-radius:12px; padding:11px 13px; margin-top:12px; }
  .ev2-detected-title{ font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:12px; color:var(--blue); margin-bottom:6px; }
  .ev2-detected-row{ display:flex; justify-content:space-between; font-size:11.5px; color:var(--text-dim); }
  .ev2-detected-row span:last-child{ color:var(--text); font-weight:600; font-family:'Space Grotesk',sans-serif; }
  .arrival-info{ font-size:11.5px; }
  .arrival-info b{ display:block; font-family:'Space Grotesk',sans-serif; font-size:12.5px; margin-bottom:2px; }
  .arrival-card-big{ padding:12px; }
  .arrival-btn-card.big{ padding:10px 12px; }
  .arrival-info.big{ font-size:13.5px; }
  .arrival-info.big b{ font-size:15.5px; margin-bottom:6px; }
  .btn-big{ padding:9px; font-size:11.5px; }

  .ev2-picker{ display:flex; gap:10px; margin-top:10px; }
  .ev2-pick-card{ flex:1; background:var(--bg); border:1px solid var(--line); border-radius:11px; padding:12px; text-align:center; cursor:pointer; }
  .ev2-pick-card:hover{ border-color:#3A4066; }
  .ev2-pick-ic{ font-size:18px; margin-bottom:4px; }
  .ev2-pick-name{ font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:12px; }

  .compare-mini{ display:flex; flex-direction:column; gap:8px; margin-top:10px; }
  .cm-row{ background:var(--bg); border:1px solid var(--line); border-radius:10px; padding:10px 12px; display:flex; justify-content:space-between; align-items:center; }
  .cm-name{ font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:11.5px; }
  .cm-power{ font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:13px; }
  .cm-power .arrow{ color:var(--text-dim); font-weight:400; margin:0 4px; }
  .cm-status{ font-size:9px; font-family:'Space Grotesk',sans-serif; font-weight:600; padding:2px 7px; border-radius:999px; }
  .cm-status.maintained{ background:rgba(52,211,153,.14); color:var(--green); }
  .cm-status.adjusted{ background:rgba(244,183,64,.14); color:var(--amber); }
  .cm-status.paused{ background:rgba(228,41,61,.14); color:#FF6B7D; }
  .alert-box{ display:flex; gap:9px; align-items:flex-start; background:rgba(244,183,64,.08); border:1px solid rgba(244,183,64,.28); border-radius:12px; padding:12px 14px; margin-top:10px; font-size:11.5px; color:var(--text-dim); line-height:1.55; }
  .alert-box.ok{ background:rgba(52,211,153,.08); border-color:rgba(52,211,153,.28); }

  /* IA panel */
  .ai-status-row{ display:flex; align-items:center; gap:8px; margin-bottom:14px; }
  .ai-status-dot{ width:8px; height:8px; border-radius:50%; background:var(--green); box-shadow:0 0 0 4px rgba(52,211,153,.15); }
  .ai-status-txt{ font-family:'Space Grotesk',sans-serif; font-weight:600; font-size:12.5px; }
  .ai-inputs-grid{ display:grid; grid-template-columns:1fr 1fr 1fr; gap:7px; margin-bottom:14px; }
  .ai-input-chip{ display:flex; align-items:center; gap:6px; background:var(--panel-2); border:1px solid var(--line); border-radius:9px; padding:8px 9px; font-size:10.5px; color:var(--text-dim); }
  .ai-input-chip .cm{ color:var(--green); font-weight:700; }
  .ai-decision-box{ background:var(--panel-2); border:1px solid var(--line); border-radius:14px; padding:16px; }
  .ai-caption{ font-size:10px; color:var(--text-dim); margin-bottom:12px; }
  .ai-decision-note{ background:rgba(76,141,255,.07); border:1px solid rgba(76,141,255,.25); border-radius:11px; padding:11px 12px; font-size:11px; color:var(--text-dim); line-height:1.55; margin-top:9px; }

  /* Visão */
  .visao-hero{ text-align:center; padding:30px 10px 20px; }
  .visao-eyebrow{ font-family:'Space Grotesk',sans-serif; font-size:10.5px; text-transform:uppercase; letter-spacing:.12em; color:var(--pink); margin-bottom:8px; }
  .visao-title{ font-family:'Space Grotesk',sans-serif; font-weight:800; font-size:24px; margin-bottom:6px; }
  .visao-sub{ color:var(--text-dim); font-size:13px; }
  .visao-cards{ display:grid; grid-template-columns:1fr 1fr; gap:18px; padding:10px 10px 20px; }
  .visao-card{ background:var(--panel); border:1px solid var(--line); border-radius:20px; padding:28px 22px; text-align:center; cursor:pointer; transition:transform .15s; }
  .visao-card:hover{ transform:translateY(-3px); border-color:#3A4066; }
  .visao-card-ic{ font-size:34px; margin-bottom:12px; }
  .visao-card-title{ font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:15px; margin-bottom:6px; }
  .visao-card-desc{ font-size:11.5px; color:var(--text-dim); margin-bottom:16px; }

  .biz-flow{ display:flex; align-items:center; justify-content:center; gap:10px; flex-wrap:wrap; margin:20px 0; }
  .biz-flow-node{ background:var(--panel-2); border:1px solid var(--line); border-radius:12px; padding:12px 16px; text-align:center; font-family:'Space Grotesk',sans-serif; font-weight:600; font-size:12px; }
  .biz-flow-node .sub{ font-size:9.5px; color:var(--text-dim); font-weight:400; margin-top:3px; }
  .biz-flow-arrow{ color:var(--text-dim); font-size:16px; }
  .biz-example-big{ max-width:380px; margin:0 auto; background:var(--panel); border:1px solid var(--line); border-radius:16px; padding:22px; text-align:center; }
  .biz-ex-formula{ font-family:'Space Grotesk',sans-serif; font-size:15px; color:var(--text-dim); margin-bottom:10px; }
  .biz-ex-total{ font-family:'Space Grotesk',sans-serif; font-weight:800; font-size:30px; margin-bottom:16px; }
  .biz-split-bar-big{ height:12px; border-radius:8px; background:var(--bg); overflow:hidden; border:1px solid var(--line); }
  .biz-split-fill-big{ height:100%; background:linear-gradient(90deg,var(--red),var(--pink)); }
  .biz-split-labels-big{ display:flex; justify-content:space-between; font-size:11px; color:var(--text-dim); margin-top:8px; }
  .biz-demo-tag{ display:inline-block; margin-top:14px; font-size:9.5px; color:var(--text-dim); background:var(--bg); border:1px solid var(--line); padding:4px 12px; border-radius:999px; }
  .biz-section-title{ font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:13px; text-transform:uppercase; letter-spacing:.04em; color:var(--text-dim); margin:26px 0 12px; text-align:center; }
  .biz-benefits-grid{ display:grid; grid-template-columns:repeat(3,1fr); gap:10px; max-width:520px; margin:0 auto; }
  .biz-benefit-card{ background:var(--panel); border:1px solid var(--line); border-radius:14px; padding:16px 10px; text-align:center; }
  .bbc-ic{ font-size:22px; margin-bottom:8px; }
  .bbc-txt{ font-size:11px; color:var(--text-dim); line-height:1.4; }
  .biz-formula-row{ display:flex; align-items:center; justify-content:center; flex-wrap:wrap; gap:8px; max-width:560px; margin:0 auto; }
  .biz-formula-chip{ background:var(--panel); border:1px solid var(--line); border-radius:11px; padding:9px 13px; font-family:'Space Grotesk',sans-serif; font-weight:600; font-size:11.5px; }
  .biz-formula-chip.result{ background:linear-gradient(135deg,var(--red),var(--pink)); color:#fff; border:none; }
  .biz-plus{ color:var(--text-dim); font-size:13px; }

  .flow-diagram{ display:flex; flex-direction:column; align-items:center; gap:0; max-width:420px; margin:0 auto; }
  .flow-node-big{ display:flex; align-items:center; gap:14px; background:var(--panel); border:1px solid var(--line); border-radius:14px; padding:14px 18px; width:100%; }
  .flow-node-big.ai{ border-color:rgba(236,30,103,.4); background:linear-gradient(135deg,rgba(228,41,61,.08),rgba(236,30,103,.04)); }
  .flow-node-ic{ font-size:20px; width:26px; text-align:center; }
  .flow-node-txt{ font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:13px; }
  .flow-node-desc{ font-size:10.5px; color:var(--text-dim); margin-top:2px; }
  .flow-arrow-big{ color:var(--text-dim); font-size:15px; margin:2px 0; }
  .ocpp-note-big{ text-align:center; font-size:10.5px; color:var(--text-dim); opacity:.75; margin-top:14px; }
  .flow-solar-branch{ display:flex; align-items:center; gap:10px; width:100%; }
  .flow-solar-branch .flow-node-big.solar-branch-node{ border-color:rgba(244,183,64,.4); background:linear-gradient(135deg,rgba(244,183,64,.10),rgba(244,183,64,.03)); flex:1; }
  .flow-solar-branch .flow-arrow-big{ margin:0; }
  .ai-io-row{ display:flex; align-items:flex-start; justify-content:center; gap:16px; flex-wrap:wrap; max-width:560px; margin:0 auto 8px; }
  .ai-io-col{ display:flex; flex-direction:column; gap:6px; min-width:150px; }
  .ai-io-label{ font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:11px; color:var(--text-dim); text-transform:uppercase; letter-spacing:.05em; margin-bottom:2px; }
  .ai-io-chip{ background:var(--panel); border:1px solid var(--line); border-radius:9px; padding:8px 11px; font-size:11px; }
  .ai-io-arrow{ align-self:center; font-family:'Space Grotesk',sans-serif; font-size:10.5px; color:var(--text-dim); text-align:center; padding-top:24px; }
  .monitored-grid{ display:flex; flex-wrap:wrap; gap:8px; justify-content:center; max-width:560px; margin:0 auto; }
  .monitored-chip{ background:var(--panel); border:1px solid var(--line); border-radius:999px; padding:7px 14px; font-size:11px; color:var(--text-dim); font-family:'Space Grotesk',sans-serif; font-weight:600; }

  /* ============ USER (direita, ~30%, estilo mobile) ============ */
  .user-col{ flex:0 0 420px; display:flex; align-items:center; justify-content:center; align-self:stretch; }
  .phone-frame{
    width:410px; max-width:100%; height:min(756px,92vh);
    background:#0D0F1B; border:1px solid var(--line); border-radius:26px;
    display:flex; flex-direction:column; overflow:hidden;
    box-shadow:0 40px 90px -25px rgba(0,0,0,.7), inset 0 1px 0 rgba(255,255,255,.03);
  }
  .u-header{ flex-shrink:0; padding:18px 18px 14px; background:linear-gradient(180deg,#14172A,#0F111E); border-bottom:1px solid var(--line); }
  .u-top{ display:flex; align-items:center; justify-content:space-between; margin-bottom:9px; }
  .u-brand{ font-family:'Space Grotesk',sans-serif; font-weight:800; font-size:19px; }
  .u-brand .accent{ background:linear-gradient(135deg,var(--red),var(--pink)); -webkit-background-clip:text; background-clip:text; color:transparent; }
  .u-online{ display:flex; align-items:center; gap:4px; font-size:9.5px; color:var(--green); font-family:'Space Grotesk',sans-serif; font-weight:600; }
  .u-online .dot{ width:5px;height:5px;border-radius:50%; background:var(--green); }
  .u-place{ font-size:13.5px; color:var(--text-dim); font-weight:600; }
  .u-back{ display:none; align-items:center; gap:4px; cursor:pointer; font-family:'Space Grotesk',sans-serif; font-size:10.5px; font-weight:600; color:var(--text-dim); margin-top:6px; width:fit-content; }
  .u-back.show{ display:flex; }

  .u-content{ flex:1; overflow-y:auto; padding:16px 16px 14px; display:flex; flex-direction:column; }
  .u-content::-webkit-scrollbar{ width:0; }
  .u-eyebrow{ font-family:'Space Grotesk',sans-serif; font-size:9.5px; text-transform:uppercase; letter-spacing:.09em; color:var(--pink); margin-bottom:5px; }
  .u-title{ font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:16.5px; margin-bottom:4px; }
  .u-sub{ color:var(--text-dim); font-size:11px; line-height:1.5; margin-bottom:13px; }

  .u-vaga-pick{ background:var(--panel-2); border:1px solid var(--line); border-radius:13px; padding:11px 12px; display:flex; align-items:center; justify-content:space-between; margin-bottom:9px; transition:transform .15s, border-color .15s; }
  .u-vaga-pick.selectable{ cursor:pointer; border-color:rgba(76,141,255,.4); background:linear-gradient(135deg,rgba(76,141,255,.08),rgba(76,141,255,.02)); }
  .u-vaga-pick.selectable:hover{ transform:translateY(-1px); border-color:var(--blue); }
  .u-vaga-left{ display:flex; align-items:center; gap:9px; }
  .u-vaga-ic{ width:30px;height:30px;border-radius:9px; display:flex;align-items:center;justify-content:center; font-size:14px; background:var(--bg); border:1px solid var(--line); }
  .u-vaga-ic.oc{ background:linear-gradient(135deg,rgba(228,41,61,.16),rgba(236,30,103,.06)); border-color:rgba(228,41,61,.35); }
  .u-vaga-ic.lv{ background:linear-gradient(135deg,rgba(76,141,255,.16),rgba(76,141,255,.05)); border-color:rgba(76,141,255,.35); }
  .u-vaga-ic.lv.pulse{ animation:vpGlowMini 2.4s ease-in-out infinite; }
  @keyframes vpGlowMini{ 0%,100%{ box-shadow:0 0 0 0 rgba(76,141,255,.25);} 50%{ box-shadow:0 0 0 5px rgba(76,141,255,0);} }
  .u-vaga-name{ font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:12px; }

  .u-rfid-hero{ flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:14px; }
  .u-rfid-ring{ width:80px;height:80px;border-radius:50%; border:2px solid var(--pink); display:flex;align-items:center;justify-content:center; font-size:28px; cursor:pointer; position:relative; background:radial-gradient(circle,rgba(236,30,103,.08),transparent 70%); }
  .u-rfid-ring::before{ content:''; position:absolute; inset:-8px; border-radius:50%; border:1px dashed rgba(236,30,103,.4); animation:spin 8s linear infinite; }
  @keyframes spin{ to{ transform:rotate(360deg);} }
  .u-rfid-ring.scanning::after{ content:''; position:absolute; inset:-4px; border-radius:50%; border:2px solid var(--green); animation:scanline .9s ease-out; }
  @keyframes scanline{ 0%{ transform:scale(.8); opacity:1;} 100%{ transform:scale(1.5); opacity:0;} }
  .u-rfid-txt{ font-family:'Space Grotesk',sans-serif; font-weight:600; font-size:13px; text-align:center; }
  .u-id-card{ background:var(--panel-2); border:1px solid var(--line); border-radius:14px; padding:15px; width:100%; }
  .u-id-check{ width:28px;height:28px;border-radius:50%; background:rgba(52,211,153,.16); border:1px solid rgba(52,211,153,.4); display:flex;align-items:center;justify-content:center; font-size:13px; color:var(--green); margin-bottom:8px; }
  .u-id-row{ display:flex; justify-content:space-between; padding:6px 0; border-bottom:1px solid var(--line); font-size:11px; }
  .u-id-row:last-child{ border:none; }
  .u-id-row span:last-child{ font-family:'Space Grotesk',sans-serif; font-weight:600; }
  .u-authorized{ margin-top:9px; text-align:center; background:rgba(52,211,153,.12); border:1px solid rgba(52,211,153,.35); color:var(--green); font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:10.5px; letter-spacing:.05em; padding:7px; border-radius:9px; }

  .u-qty-grid{ display:grid; grid-template-columns:1fr 1fr; gap:8px; margin-bottom:10px; }
  .u-qty-card{ background:var(--panel-2); border:1px solid var(--line); border-radius:12px; padding:12px 6px; text-align:center; cursor:pointer; position:relative; }
  .u-qty-custom{ display:flex; gap:8px; align-items:center; background:var(--panel-2); border:1px solid var(--line); border-radius:12px; padding:10px 12px; margin-bottom:10px; }
  .u-qty-custom label{ font-size:10.5px; color:var(--text-dim); white-space:nowrap; }
  .u-qty-custom input{ flex:1; background:var(--bg); border:1px solid var(--line); color:var(--text); border-radius:8px; padding:8px; font-family:'Space Grotesk',sans-serif; font-weight:600; font-size:12px; width:0; }
  .u-qty-confirm{ text-align:center; background:rgba(52,211,153,.1); border:1px solid rgba(52,211,153,.3); border-radius:11px; padding:9px; font-family:'Space Grotesk',sans-serif; font-weight:700; color:var(--green); font-size:11.5px; margin-bottom:10px; }
  .u-choice-stats{ display:flex; gap:7px; padding-left:34px; margin-top:8px; }
  .u-choice-stat{ background:var(--bg); border:1px solid var(--line); border-radius:9px; padding:6px 8px; text-align:center; flex:1; }
  .u-choice-stat .cl{ font-size:8px; color:var(--text-dim); margin-bottom:2px; }
  .u-choice-stat .cv{ font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:11px; }
  .u-choice-stat .cv.time-accent{ color:var(--blue); }
  .u-ai-checklist{ display:grid; grid-template-columns:1fr 1fr; gap:5px; margin-bottom:10px; }
  .u-ai-check-item{ display:flex; align-items:center; gap:5px; background:var(--bg); border:1px solid var(--line); border-radius:8px; padding:6px 8px; font-size:9.5px; color:var(--text-dim); }
  .u-ai-check-item .cm{ color:var(--green); font-weight:700; font-size:10px; }
  .u-pix-tag{ display:inline-flex; align-items:center; gap:5px; font-size:9px; color:var(--blue); background:rgba(76,141,255,.1); border:1px solid rgba(76,141,255,.3); padding:4px 9px; border-radius:999px; margin-bottom:10px; font-family:'Space Grotesk',sans-serif; font-weight:600; }
  .u-estrato-box{ background:var(--panel-2); border:1px dashed #3A4066; border-radius:13px; padding:13px 14px; margin-top:8px; text-align:left; }
  .u-estrato-title{ font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:10.5px; text-transform:uppercase; letter-spacing:.05em; color:var(--text-dim); margin-bottom:8px; }
  .u-estrato-line{ padding:7px 0; border-bottom:1px solid var(--line); display:flex; justify-content:space-between; align-items:center; }
  .u-estrato-line:last-child{ border-bottom:none; }
  .u-estrato-fonte{ font-family:'Space Grotesk',sans-serif; font-weight:600; font-size:12px; }
  .u-estrato-calc{ font-size:10.5px; color:var(--text-dim); }
  .u-estrato-sub{ font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:13px; }
  .u-cap-bar-block{ background:var(--panel-2); border:1px solid var(--line); border-radius:13px; padding:12px 13px; margin-bottom:10px; }
  .u-cap-bar-top{ display:flex; justify-content:space-between; align-items:center; margin-bottom:7px; }
  .u-cap-bar-label{ font-size:9.5px; text-transform:uppercase; letter-spacing:.05em; color:var(--text-dim); font-family:'Space Grotesk',sans-serif; font-weight:600; }
  .u-cap-bar-solar{ font-size:10px; font-family:'Space Grotesk',sans-serif; font-weight:600; }
  .u-cap-bar-solar.on{ color:var(--green); }
  .u-cap-bar-solar.off{ color:var(--text-dim); }
  .u-cap-bar-track{ height:12px; border-radius:7px; background:var(--bg); border:1px solid var(--line); overflow:hidden; }
  .u-cap-bar-fill{ height:100%; background:linear-gradient(90deg,var(--green),#26B583); transition:width .5s ease; }
  .u-cap-bar-fill.off{ background:linear-gradient(90deg,var(--blue),#3A6FD9); }
  .u-cap-bar-sub{ text-align:center; font-size:10px; color:var(--text-dim); margin-top:6px; }
  .u-cap-bar-sub b{ color:var(--text); font-family:'Space Grotesk',sans-serif; }
  .u-energy-mini-row{ display:flex; gap:7px; margin-bottom:9px; }
  .u-emr-item{ flex:1; background:var(--panel-2); border:1px solid var(--line); border-radius:11px; padding:9px 8px; text-align:center; }
  .u-emr-item.u-emr-solo{ flex:0 0 auto; }
  .u-emr-ic{ font-size:12px; margin-bottom:3px; }
  .u-emr-label{ font-size:8px; color:var(--text-dim); margin-bottom:2px; }
  .u-emr-val{ font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:12px; }
  .u-consumo-note{ font-size:9.5px; color:var(--text-dim); text-align:center; margin-top:9px; line-height:1.5; opacity:.8; }
  .u-qty-card.selected{ border-color:var(--red); background:linear-gradient(135deg,rgba(228,41,61,.14),rgba(236,30,103,.06)); }
  .u-qty-card.reco{ border-color:rgba(52,211,153,.4); }
  .u-qty-badge{ position:absolute; top:-7px; left:50%; transform:translateX(-50%); font-size:7px; font-family:'Space Grotesk',sans-serif; font-weight:700; text-transform:uppercase; background:var(--green); color:#0B0D18; padding:2px 6px; border-radius:999px; white-space:nowrap; }
  .u-qty-val{ font-family:'Space Grotesk',sans-serif; font-weight:800; font-size:17px; }
  .u-qty-unit{ font-size:9px; color:var(--text-dim); }

  .u-choice-card{ background:var(--panel-2); border:1px solid var(--line); border-radius:13px; padding:13px; margin-bottom:9px; cursor:pointer; }
  .u-choice-card:hover{ border-color:#3A4066; }
  .u-choice-head{ display:flex; align-items:center; gap:8px; margin-bottom:6px; }
  .u-choice-ic{ width:26px;height:26px;border-radius:8px; display:flex;align-items:center;justify-content:center; font-size:13px; }
  .u-choice-ic.a{ background:rgba(244,183,64,.12); }
  .u-choice-ic.b{ background:rgba(52,211,153,.12); }
  .u-choice-name{ font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:13px; }
  .u-choice-tags{ display:flex; flex-wrap:wrap; gap:5px; padding-left:34px; }
  .u-choice-tag{ font-size:9px; background:var(--bg); border:1px solid var(--line); padding:3px 7px; border-radius:999px; color:var(--text-dim); }

  .u-ai-thinking{ flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:16px; }
  .u-ai-badge-wrap{ position:relative; width:72px; height:72px; }
  .u-ai-badge{
    width:72px;height:72px;border-radius:20px;
    background:linear-gradient(135deg,rgba(228,41,61,.22),rgba(236,30,103,.12));
    border:1.5px solid rgba(236,30,103,.4);
    display:flex;align-items:center;justify-content:center; font-size:30px;
    animation:pulse 1.4s ease-in-out infinite;
    box-shadow:0 0 22px -5px rgba(236,30,103,.45);
    position:relative; z-index:2;
  }
  .u-ai-badge-wrap::before{
    content:''; position:absolute; inset:-8px; border-radius:26px;
    border:1.5px dashed rgba(236,30,103,.45);
    animation:spin 6s linear infinite;
  }
  .u-ai-badge-wrap::after{
    content:''; position:absolute; inset:-16px; border-radius:32px;
    background:radial-gradient(circle, rgba(228,41,61,.16), transparent 70%);
    animation:pulse 1.4s ease-in-out infinite;
  }
  @keyframes pulse{ 0%,100%{ transform:scale(1); opacity:1; } 50%{ transform:scale(1.08); opacity:.75; } }
  .u-ai-txt{ font-family:'Space Grotesk',sans-serif; font-weight:600; font-size:12px; color:var(--text-dim); text-align:center; }
  .u-ai-dots{ display:inline-flex; gap:3px; margin-left:2px; vertical-align:middle; }
  .u-ai-dots span{ width:3.5px; height:3.5px; border-radius:50%; background:var(--pink); display:inline-block; animation:dotBounce 1.2s ease-in-out infinite; }
  .u-ai-dots span:nth-child(2){ animation-delay:.15s; }
  .u-ai-dots span:nth-child(3){ animation-delay:.3s; }
  @keyframes dotBounce{ 0%,60%,100%{ opacity:.25; transform:translateY(0);} 30%{ opacity:1; transform:translateY(-3px);} }

  .u-charge-hero{ text-align:center; margin-bottom:12px; }
  .u-charge-pct-wrap{ position:relative; width:118px; height:118px; margin:6px auto 4px; }
  .u-charge-pct-bg{ fill:none; stroke:var(--line); stroke-width:8; }
  .u-charge-pct-fg{ fill:none; stroke:url(#uChargeGrad); stroke-width:8; stroke-linecap:round; transition:stroke-dashoffset .8s ease; }
  .u-charge-pct-txt{ position:absolute; inset:0; display:flex; align-items:center; justify-content:center; flex-direction:column; }
  .u-charge-pct-num{ font-family:'Space Grotesk',sans-serif; font-weight:800; font-size:24px; }
  .u-charge-pct-label{ font-size:8px; color:var(--text-dim); text-transform:uppercase; }
  .u-accel-tag{ text-align:center; font-size:9px; color:var(--text-dim); opacity:.7; margin-top:-2px; margin-bottom:4px; font-family:'Space Grotesk',sans-serif; font-weight:600; }
  .u-charge-pct-fg.charging{ filter:drop-shadow(0 0 5px rgba(228,41,61,.5)); }
  .u-charge-pct-num.done{ color:var(--green); }
  .u-charge-stats{ display:grid; grid-template-columns:1fr 1fr; gap:7px; margin-bottom:9px; }
  .u-charge-stat{ background:var(--panel-2); border:1px solid var(--line); border-radius:11px; padding:9px; text-align:center; }
  .u-charge-stat.full{ grid-column:1/-1; }
  .u-charge-stat .cl{ font-size:8.5px; color:var(--text-dim); margin-bottom:3px; }
  .u-charge-stat .cv{ font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:13.5px; }
  .u-charge-stat .cv.flash{ animation:flashChange .6s ease; }
  @keyframes flashChange{ 0%{ color:var(--amber); transform:scale(1.1);} 100%{ color:var(--text); transform:scale(1);} }
  .u-charge-stat.time-hero{
    background:linear-gradient(135deg, rgba(76,141,255,.12), rgba(76,141,255,.02));
    border-color:rgba(76,141,255,.35);
    padding:11px 9px;
  }
  .u-charge-stat.time-hero .cl{ display:flex; align-items:center; justify-content:center; gap:4px; }
  .u-charge-stat.time-hero .cl::before{ content:'⏱️'; font-size:9px; }
  .u-charge-stat.time-hero .cv{ font-size:19px; color:var(--blue); letter-spacing:-0.01em; }
  .u-charge-stat.time-hero .cv.flash{ animation:flashChangeTimeMini .6s ease; }
  @keyframes flashChangeTimeMini{ 0%{ color:var(--amber); transform:scale(1.12);} 100%{ color:var(--blue); transform:scale(1);} }
  .u-charge-status{ display:flex; align-items:center; gap:6px; justify-content:center; background:rgba(52,211,153,.1); border:1px solid rgba(52,211,153,.3); border-radius:9px; padding:8px; font-size:10.5px; color:var(--green); font-family:'Space Grotesk',sans-serif; font-weight:600; margin-bottom:8px; }
  .u-charge-status.warn{ background:rgba(244,183,64,.1); border-color:rgba(244,183,64,.3); color:var(--amber); }
  .u-notice{ display:none; gap:8px; align-items:flex-start; background:rgba(76,141,255,.08); border:1px solid rgba(76,141,255,.25); border-radius:11px; padding:10px 11px; margin-bottom:9px; font-size:10px; color:var(--text-dim); line-height:1.5; }
  .u-notice.show{ display:flex; animation:slideIn .3s ease; }
  @keyframes slideIn{ from{ opacity:0; transform:translateY(-6px);} to{ opacity:1; transform:translateY(0);} }
  .u-charge-note{ font-size:9.5px; color:var(--text-dim); text-align:center; line-height:1.5; opacity:.8; margin-bottom:10px; }

  .u-visao-mini{ text-align:center; padding:20px 10px; color:var(--text-dim); font-size:11px; line-height:1.6; }
  .u-visao-mini .vic{ font-size:26px; margin-bottom:8px; }

  .u-pix-box{ background:var(--panel-2); border:1px dashed #3A4066; border-radius:13px; padding:14px; text-align:left; }
  .u-pix-row{ display:flex; justify-content:space-between; font-size:11px; padding:6px 0; }
  .u-pix-row span:first-child{ color:var(--text-dim); }
  .u-pix-row.total{ border-top:1px solid var(--line); margin-top:4px; padding-top:9px; font-size:13.5px; font-weight:700; font-family:'Space Grotesk',sans-serif; }

  .hidden{ display:none !important; }
  .step-panel{ display:flex; flex-direction:column; flex:1; }

  .footnote-mini{ text-align:center; font-size:8.5px; color:var(--text-dim); opacity:.65; margin-top:8px; line-height:1.4; }

  @media (max-width:980px){
    .app-wrap{ flex-direction:column; padding:16px; gap:16px; }
    .admin-col{ order:2; border-radius:18px; }
    .user-col{ order:1; flex:none; width:100%; min-width:0; }
  }
</style>
</head>
<body>

<div class="app-wrap">

  <!-- ============ ADMIN ============ -->
  <div class="admin-col" id="adminCol">

    <div class="admin-window-bar">
      <div class="admin-window-dot red"></div>
      <div class="admin-window-dot yellow"></div>
      <div class="admin-window-dot green"></div>
      <div class="admin-window-title">wecharge-control.app — Mercadinho Bom Preço</div>
    </div>

    <div class="admin-header">
      <div class="admin-brand">
        <div>
          <div class="admin-brand-word">⚡ We<span class="accent">Charge</span> Control</div>
          <div class="admin-brand-sub">Administrativo</div>
        </div>
      </div>
      <div class="admin-online"><span class="dot"></span>Sistema online</div>
    </div>
    <div class="admin-place-row">
      <div class="admin-place">Mercadinho Bom Preço</div>
      <div class="admin-partner"><span>FIAP</span><span class="admin-partner-x">×</span><img src="data:image/png;base64," alt="GoodWe" class="goodwe-logo"></div>
    </div>

    <div class="admin-nav">
      <div class="admin-nav-item active" data-view="geral" onclick="setAdminView('geral')">🏠 Visão Geral</div>
      <div class="admin-nav-item" data-view="recarga" onclick="setAdminView('recarga')">⚡ Recargas</div>
      <div class="admin-nav-item" data-view="energia" onclick="setAdminView('energia')">📊 Energia</div>
      <div class="admin-nav-item" data-view="ia" onclick="setAdminView('ia')">🧠 IA</div>
      <div class="admin-nav-item" data-view="visao" onclick="setAdminView('visao')">💼 Visão</div>
    </div>

    <!-- ADMIN: RECARGA -->
    <!-- ADMIN: VISÃO GERAL (dashboard principal) -->
    <div id="adminGeral">
      <div class="dash-grid">
        <div class="dash-col-main">
          <div class="a-card" style="padding-left:14px; padding-right:14px;">
            <div class="a-card-title-row" style="padding:0 4px;">
              <div class="a-card-title" style="margin-bottom:0;">🏢 Estação</div>
              <div class="status-pill" id="geralStatusPill"><span class="status-pill-dot"></span>Normal</div>
            </div>
            <div class="grid4">
              <div class="stat-box"><div class="sb-label">Rede contratada</div><div class="sb-val">⚡ 30 kW</div></div>
              <div class="stat-box"><div class="sb-label">Consumo local</div><div class="sb-val">🏠 10 kW</div></div>
              <div class="stat-box"><div class="sb-label">Rede disponível</div><div class="sb-val">🔌 20 kW</div></div>
              <div class="stat-box"><div class="sb-label">Solar disponível</div><div class="sb-val pos" id="geralSolarKw">☀️ +10 kW</div></div>
            </div>
            <div class="cap-bar-header" style="padding:0 4px;">
              <span>Capacidade para EVs agora</span>
              <b id="geralCapTxt">30 kW disponíveis</b>
            </div>
            <div class="a-bar-track" style="margin:0 4px; width:calc(100% - 8px);"><div class="a-bar-fill" id="geralCapBar" style="width:100%"></div></div>
            <div class="cap-bar-sub-split" id="geralCapSplit">🔌 20 kW da rede <span class="plus">+</span> ☀️ 10 kW solar</div>
          </div>
        </div>

        <div class="dash-col-side">
          <div class="a-card arrival-card-big">
            <div class="a-card-title" style="font-size:12.5px;">🚗 Nova chegada</div>
            <div class="arrival-btn-card big">
              <div class="arrival-info big"><b>Simular entrada de outro veículo</b>Adiciona o EV-02 à estação</div>
            </div>
            <button class="btn btn-primary btn-block btn-big" style="margin-top:10px;" id="btnNovaChegadaGeral" onclick="iniciarNovaChegadaDeGeral()" disabled>+ Adicionar EV-02</button>
          </div>
        </div>
      </div>

      <div class="a-card-title section-title">☀️ Energia</div>
      <div class="grid3-energy">
        <div class="a-card mini-card">
          <div class="mini-card-title">☀️ Geração solar (agora)</div>
          <div class="mini-card-big pos" id="geralGeracaoSolar">+10 kW</div>
          <div class="mini-card-sub" id="geralGeracaoStatus">Solar ativa</div>
          <svg class="solar-sparkline" viewBox="0 0 200 90" preserveAspectRatio="none">
            <defs>
              <linearGradient id="solarAreaGrad" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#34D399" stop-opacity="0.45"/>
                <stop offset="100%" stop-color="#34D399" stop-opacity="0"/>
              </linearGradient>
            </defs>
            <line x1="20" y1="18" x2="200" y2="18" stroke="#2A2F48" stroke-width="1"/>
            <line x1="20" y1="46" x2="200" y2="46" stroke="#2A2F48" stroke-width="1"/>
            <text x="0" y="21" fill="#9096B0" font-size="9" font-family="Space Grotesk">20</text>
            <text x="0" y="49" fill="#9096B0" font-size="9" font-family="Space Grotesk">10</text>
            <text x="0" y="73" fill="#9096B0" font-size="9" font-family="Space Grotesk">0</text>
            <polygon points="20,70 20,58 40,32 60,26 80,24 100,28 120,25 140,22 160,30 180,42 200,50 200,70" fill="url(#solarAreaGrad)"/>
            <polyline points="20,58 40,32 60,26 80,24 100,28 120,25 140,22 160,30 180,42 200,50" fill="none" stroke="#34D399" stroke-width="2.2" stroke-linejoin="round" stroke-linecap="round"/>
          </svg>
          <div class="sparkline-axis"><span>00:00</span><span>06:00</span><span>12:00</span><span>18:00</span><span>24:00</span></div>
        </div>

        <div class="a-card mini-card">
          <div class="mini-card-title">🔋 Reserva solar</div>
          <div class="battery-visual-row" style="padding:2px 0 4px;">
            <div class="battery-pct-big" id="geralReservaPct" style="font-size:24px;">100%</div>
            <div class="battery-shape" style="width:100%; max-width:150px;">
              <div class="battery-fill" id="geralReservaFill" style="width:100%"></div>
            </div>
          </div>
          <div class="mini-card-sub" id="geralReservaKwh" style="text-align:center;">60 kWh disponíveis</div>
          <div class="mini-card-sub" id="geralReservaCargas" style="text-align:center;">≈ 3 cargas de 20 kWh</div>
          <button class="btn btn-ghost btn-block" style="margin-top:auto; padding-top:8px;" onclick="setAdminView('energia')">Detalhes da reserva</button>
        </div>

        <div class="a-card mini-card">
          <div class="mini-card-title-row">
            <div class="mini-card-title" style="margin-bottom:0;">⚡ Fluxo de energia</div>
            <div class="status-pill mini" id="geralFluxoPill"><span class="status-pill-dot"></span>Ativa</div>
          </div>
          <div class="flow-diagram-mini">
            <div class="flow-row-mini">
              <div class="flow-node-mini"><div class="fnm-ic">🔌</div><div class="fnm-txt">Rede<br><b id="geralFluxoRede">20 kW</b></div></div>
              <div class="flow-arrow-mini blue">←</div>
              <div class="flow-hub">⚡</div>
              <div class="flow-arrow-mini amber">→</div>
              <div class="flow-node-mini"><div class="fnm-ic">☀️</div><div class="fnm-txt">Solar<br><b id="geralFluxoSolar" class="pos">+10 kW</b></div></div>
            </div>
            <div class="flow-arrow-mini down">↓</div>
            <div class="flow-node-mini wide"><div class="fnm-ic">🚗</div><div class="fnm-txt">EVs<br><b id="geralFluxoEvs">30 kW</b></div></div>
          </div>
        </div>
      </div>

      <div class="a-card">
        <div class="a-card-title">📋 Sessões ativas</div>
        <div class="sessions-table-wrap">
          <table class="sessions-table">
            <thead><tr><th>Vaga</th><th>Veículo</th><th>Modo</th><th>Potência</th><th>Status</th><th>Progresso</th></tr></thead>
            <tbody id="geralSessionsTableBody"></tbody>
          </table>
        </div>
      </div>

      <div class="dash-footer">
        <span class="dash-footer-updated">Última atualização: agora ⟳</span>
      </div>
    </div>

    <div id="adminRecarga" class="hidden">
      <div class="grid2">
        <div class="a-card">
          <div class="a-card-title">🔌 Estação</div>
          <div class="grid3">
            <div class="a-stat"><div class="al">Capacidade</div><div class="av" id="admCap">30 kW</div></div>
            <div class="a-stat"><div class="al">Demanda</div><div class="av" id="admDem">0 kW</div></div>
            <div class="a-stat"><div class="al">Solar</div><div class="av pos" id="admSolarKw">10 kW</div></div>
          </div>
          <div class="a-bar-track" style="margin-top:12px;"><div class="a-bar-fill" id="admCapBar" style="width:0%"></div></div>
          <div style="text-align:center; font-size:11px; color:var(--text-dim); margin-top:4px;">Sistema: <b id="admSistemaStatus" style="color:var(--green); font-family:'Space Grotesk',sans-serif;">NORMAL</b></div>
          <div class="demand-indicator" id="admDemandIndicator"><span id="admDemandDot">🟢</span> <span id="admDemandTxt">Demanda normal</span></div>
        </div>

        <div class="a-card">
          <div class="a-card-title">🚗 Nova chegada</div>
          <div class="arrival-btn-card">
            <div class="arrival-info"><b>Simular entrada de outro veículo</b>Adiciona o EV-02 à estação</div>
          </div>
          <button class="btn btn-primary btn-block" style="margin-top:10px;" id="btnNovaChegada" onclick="simularNovaChegada()" disabled>+ Adicionar EV-02</button>
          <div id="admEv2Picker" class="hidden">
            <div class="ev2-detected-box">
              <div class="ev2-detected-title">🚗 EV-02 DETECTADO</div>
              <div class="ev2-detected-row"><span>Energia solicitada</span><span>20 kWh</span></div>
            </div>
            <div style="font-size:11px; color:var(--text-dim); margin-top:10px; margin-bottom:4px;"><b style="color:var(--text); font-family:'Space Grotesk',sans-serif;">Como deseja carregar?</b></div>
            <div class="ev2-picker">
              <div class="ev2-pick-card" onclick="escolherModoEv2('urgente')"><div class="ev2-pick-ic">⚡</div><div class="ev2-pick-name">Urgente</div></div>
              <div class="ev2-pick-card" onclick="escolherModoEv2('economizar')"><div class="ev2-pick-ic">🌱</div><div class="ev2-pick-name">Economizar</div></div>
            </div>
          </div>
          <div id="admCompareBox" class="hidden">
            <div class="compare-mini" id="admCompareRows"></div>
            <div class="alert-box" id="admAlertBox"></div>
          </div>
        </div>
      </div>

      <div class="a-card">
        <div class="a-card-title">☀️ Energia solar</div>
        <div class="solar-toggle-card">
          <div class="solar-toggle-info">
            <div class="solar-ic" id="admSolarIconMini">☀️</div>
            <div><div class="solar-status on" id="admSolarStatusMini">ATIVA</div><div class="solar-sub" id="admSolarSubMini">+10 kW</div></div>
          </div>
          <button class="btn btn-ghost" id="btnToggleSolarMini" onclick="toggleSolar()">Desativar solar</button>
        </div>
      </div>

      <div class="a-card">
        <div class="a-card-title">📋 Sessões ativas</div>
        <div id="admSessions"><div class="session-empty">Aguardando motorista se identificar...</div></div>
      </div>
    </div>

    <!-- ADMIN: ENERGIA -->
    <div id="adminEnergia" class="hidden">
      <div class="a-card">
        <div class="a-card-title">⚡ Energia da estação</div>
        <div class="grid3">
          <div class="a-stat"><div class="al">Rede contratada</div><div class="av">30 kW</div></div>
          <div class="a-stat"><div class="al">Consumo local</div><div class="av neg">−10 kW</div></div>
          <div class="a-stat"><div class="al">Disponível p/ EVs</div><div class="av">20 kW</div></div>
        </div>
        <div style="margin-top:14px;">
          <div style="font-size:10.5px; color:var(--text-dim); margin-bottom:6px; text-transform:uppercase; letter-spacing:.05em; font-family:'Space Grotesk',sans-serif; font-weight:600;">Capacidade EV</div>
          <div class="a-bar-track"><div class="a-bar-fill" id="admEnergiaBar" style="width:100%"></div></div>
          <div style="text-align:center; font-size:12px; color:var(--text-dim); margin-top:6px;"><b id="admEnergiaTotalTxt" style="color:var(--text); font-family:'Space Grotesk',sans-serif;">30 / 30 kW</b></div>
        </div>
      </div>

      <div class="a-card">
        <div class="a-card-title">☀️ Geração solar</div>
        <div class="solar-toggle-card">
          <div class="solar-toggle-info">
            <div class="solar-ic" id="admSolarIcon">☀️</div>
            <div><div class="solar-status on" id="admSolarStatusTxt">ATIVA</div><div class="solar-sub" id="admSolarSubTxt">Contribuindo +10 kW para a capacidade</div></div>
          </div>
          <button class="btn btn-ghost" id="btnToggleSolar" onclick="toggleSolar()">Desativar solar</button>
        </div>
        <div class="kw-kwh-caption">☀️ <b>+10 kW</b> — potência solar disponível agora <span class="kw-kwh-sep">·</span> não é a quantidade de energia armazenada</div>
        <div class="solar-transition-notice hidden" id="admSolarAviso">
          ☀️ Energia solar esgotada — 🔌 recarga continua utilizando a rede.
          <span class="solar-aviso-close" onclick="fecharAvisoSolarEsgotado()">✕</span>
        </div>
      </div>

      <div class="a-card">
        <div class="a-card-title">🔋 Reserva solar (simulada)</div>
        <div class="battery-visual-row">
          <div class="battery-pct-big" id="reservaSolarPctBig">100%</div>
          <div class="battery-shape" style="width:100%; max-width:170px;">
            <div class="battery-fill" id="reservaSolarBatteryFill" style="width:100%"></div>
          </div>
        </div>
        <div class="kw-kwh-caption center">🔋 <b id="reservaSolarKwhTxt">60 kWh</b> disponíveis na reserva</div>
        <div class="grid2" style="margin-top:10px;">
          <div class="a-stat"><div class="al">Autonomia estimada</div><div class="av" id="reservaSolarCargasTxt" style="font-size:12px;">≈ 3 cargas de 20 kWh</div></div>
          <div class="a-stat"><div class="al">Restante após cargas</div><div class="av" id="reservaSolarRestanteTxt" style="font-size:14px;">0 kWh</div></div>
        </div>
        <div class="reserva-solar-note">Reserva solar simulada — não representa uma bateria física instalada no estabelecimento.</div>
      </div>
    </div>

    <!-- ADMIN: IA -->
    <div id="adminIA" class="hidden">
      <div class="a-card">
        <div class="a-card-title">🧠 WeCharge AI</div>
        <div class="ai-status-row"><div class="ai-status-dot"></div><div class="ai-status-txt">Monitorando</div></div>
        <div class="ai-inputs-grid">
          <div class="ai-input-chip"><span class="cm">✓</span>Solar</div>
          <div class="ai-input-chip"><span class="cm">✓</span>Capacidade</div>
          <div class="ai-input-chip"><span class="cm">✓</span>Consumo local</div>
          <div class="ai-input-chip"><span class="cm">✓</span>Veículos</div>
          <div class="ai-input-chip"><span class="cm">✓</span>Prioridade</div>
          <div class="ai-input-chip"><span class="cm">✓</span>Energia solicitada</div>
        </div>
        <div class="ai-decision-box">
          <div class="ai-caption">Motor de decisão inteligente · simulação baseada em regras</div>
          <div id="admIaDecision" class="grid3">
            <div class="a-stat"><div class="al">Fonte</div><div class="av" id="admIaFonte" style="font-size:13px;">—</div></div>
            <div class="a-stat"><div class="al">Potência</div><div class="av" id="admIaPotencia" style="font-size:15px;">—</div></div>
            <div class="a-stat"><div class="al">Tarifa</div><div class="av" id="admIaTarifa" style="font-size:13px;">—</div></div>
          </div>
          <div class="grid2" style="margin-top:10px;">
            <div class="a-stat"><div class="al">Tempo estimado</div><div class="av" id="admIaTempo" style="font-size:14px;">—</div></div>
            <div class="a-stat"><div class="al">Veículos ativos</div><div class="av" id="admIaVeiculos" style="font-size:14px;">—</div></div>
          </div>
          <div class="ai-decision-note" id="admIaDecisaoTxt">—</div>
        </div>
      </div>
    </div>

    <!-- ADMIN: VISÃO -->
    <div id="adminVisao" class="hidden">
      <div id="visaoMenu">
        <div class="visao-hero">
          <div class="visao-eyebrow">Modo apresentação</div>
          <div class="visao-title">💼 Visão WeCharge</div>
          <div class="visao-sub">Apresentação estratégica do ecossistema — não altera a sessão em andamento.</div>
        </div>
        <div class="visao-cards">
          <div class="visao-card" onclick="setVisaoSub('business')">
            <div class="visao-card-ic">💼</div>
            <div class="visao-card-title">WeCharge Business</div>
            <div class="visao-card-desc">Modelo de negócio e distribuição de receita</div>
            <button class="btn btn-primary">Ver modelo</button>
          </div>
          <div class="visao-card" onclick="setVisaoSub('dataflow')">
            <div class="visao-card-ic">🔗</div>
            <div class="visao-card-title">Data Flow</div>
            <div class="visao-card-desc">Como dados, hardware e IA se conectam</div>
            <button class="btn btn-primary">Ver arquitetura</button>
          </div>
        </div>
      </div>

      <div id="visaoBusiness" class="hidden">
        <div class="back-btn-visao" onclick="setVisaoSub(null)" style="cursor:pointer; font-family:'Space Grotesk',sans-serif; font-size:11.5px; color:var(--text-dim); margin-bottom:16px;">← Voltar para Visão</div>
        <div class="visao-hero" style="padding-top:6px;">
          <div class="visao-title" style="font-size:20px;">💼 WeCharge Business</div>
          <div class="visao-sub">Como o ecossistema gera valor</div>
        </div>
        <div class="biz-flow">
          <div class="biz-flow-node">🚗 Motorista<div class="sub">paga pela recarga</div></div>
          <div class="biz-flow-arrow">→</div>
          <div class="biz-flow-node">⚡ WeCharge<div class="sub">gestão + tecnologia</div></div>
