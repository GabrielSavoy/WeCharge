        </div>

        <div id="uPagamento" class="step-panel hidden">
          <div style="text-align:center; margin-bottom:12px;">
            <div style="width:44px;height:44px;border-radius:50%; background:rgba(52,211,153,.14); border:1px solid rgba(52,211,153,.4); display:flex;align-items:center;justify-content:center; font-size:20px; margin:0 auto 8px;">✓</div>
            <div style="font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:14px;">RECARGA CONCLUÍDA</div>
          </div>
          <div class="u-pix-tag">🔗 Pix · cobrança automática</div>
          <div class="u-pix-box">
            <div class="u-pix-row"><span>Usuário</span><span>Gabriel</span></div>
            <div class="u-pix-row"><span>Vaga</span><span>02</span></div>
            <div class="u-pix-row"><span>Energia</span><span id="uPayFonte">Solar + Rede</span></div>
            <div class="u-pix-row"><span>Energia consumida</span><span id="uPayKwh">20 kWh</span></div>
          </div>

          <div class="u-estrato-box" id="uEstratoUrgente">
            <div class="u-estrato-title">Detalhamento da recarga</div>
            <div class="u-pix-row"><span>Tarifa aplicada</span><span id="uPayTarifaUrgente">R$ 1,89/kWh</span></div>
          </div>

          <div class="u-estrato-box hidden" id="uEstratoSplit">
            <div class="u-estrato-title">Detalhamento da recarga</div>
            <div class="u-estrato-line">
              <div><div class="u-estrato-fonte">☀️ Energia Solar</div><div class="u-estrato-calc" id="uEstratoSolarCalc">10,0 kWh × R$ 0,55</div></div>
              <div class="u-estrato-sub" id="uEstratoSolarSub">R$ 5,50</div>
            </div>
            <div class="u-estrato-line">
              <div><div class="u-estrato-fonte">🔌 Energia da Rede</div><div class="u-estrato-calc" id="uEstratoRedeCalc">10,0 kWh × R$ 1,05</div></div>
              <div class="u-estrato-sub" id="uEstratoRedeSub">R$ 10,50</div>
            </div>
          </div>

          <div class="u-pix-box" style="margin-top:8px;">
            <div class="u-pix-row total"><span>Total</span><span id="uPayTotal">R$ 11,00</span></div>
            <div class="u-pix-row"><span>Pagamento</span><span>PIX ✓</span></div>
          </div>
        </div>

      </div>
    </div>
  </div>

</div>

<script>
  // ================= ESTADO GLOBAL ÚNICO =================
  const TARIFA_URGENTE = 1.89;
  const TARIFA_SOLAR = 0.55;
  const TARIFA_REDE = 1.05;
  const POT_URGENTE = 11;
  const POT_ECONOMIZAR = 5.5;
  const POT_MIN_ECONOMIZAR = 2;
  const REDE_CONTRATADA = 30;
  const CONSUMO_ESTABELECIMENTO = 10;
  const DISPONIVEL_EVS_BASE = REDE_CONTRATADA - CONSUMO_ESTABELECIMENTO; // 20
  const CAP_BONUS_SOLAR = 10;
  const EV2_KWH_DEMO = 20;
  const VAGA1_VEICULO = 'Nissan Leaf'; // veículo fixo já carregando na Vaga 01

  let appState = {
    vaga: '02', usuario: 'Gabriel', veiculo: 'BYD Dolphin',
    rfidDone: false,
    solarOn: true,
    solarEsgotado: false,
    reservaSolarKwh: 60,
    mostrarAvisoSolarEsgotado: false,
    energiaDesejada: null,
    meuModo: null, meuPower: null, meuTarifa: null, meuFonteTxt: '',
    energiaSolarConsumida: 0, energiaRedeConsumida: 0, // cobrança dividida por fonte real
    aiDone: false, chargingStarted: false,
    progressoPct: 38, // progresso simulado da sessão de demonstração
    ev2Active: false, ev2Modo: null, ev2Power: null,
    lastEv2Result: null,
    paymentDone: false,
    adminView: 'geral', visaoSub: null,
    userStep: 'vaga'
  };

  function capacidadeAtual(){ return DISPONIVEL_EVS_BASE + ((appState.solarOn && !appState.solarEsgotado) ? CAP_BONUS_SOLAR : 0); }

  // Fonte única de verdade pro estado da recarga — elimina qualquer possibilidade de
  // mostrar "100% concluído" e "Pausada" ao mesmo tempo, porque é sempre um só valor.
  function estadoRecarga(){
    if (appState.progressoPct >= 100) return 'concluida';
    if (appState.meuPower <= 0) return 'pausada';
    return 'carregando';
  }

  // Fonte única da energia já consumida na sessão de demonstração — usada tanto no
  // admin (progresso da sessão) quanto no usuário (círculo/energia restante).
  function energiaConsumidaAtual(){
    if (!appState.energiaDesejada) return 0;
    return +(appState.energiaDesejada * appState.progressoPct / 100).toFixed(1);
  }

  // ---------- Animação de bateria (simulação acelerada, mesma fonte de verdade) ----------
  // A porcentagem sobe de forma contínua até 100% — o admin e o celular leem o mesmo
  // appState.progressoPct, então a bateria nunca fica dessincronizada entre as duas telas.
  let chargingInterval = null;

  function iniciarAnimacaoBateria(){
    if (chargingInterval) return; // já rodando, não duplicar
    appState.progressoPct = 4;
    registrarConsumoPorFonte(4); // contabiliza o salto inicial na fonte certa, sem deixar kWh "sem dono"
    chargingInterval = setInterval(function(){
      if (appState.paymentDone) { pararAnimacaoBateria(); return; }

      const estado = estadoRecarga();
      if (estado === 'concluida') {
        pararAnimacaoBateria();
        renderAll();
        return;
      }
      if (estado === 'pausada') {
        // Congela por completo: não incrementa porcentagem, não consome reserva solar,
        // não avança nada — mas o loop continua vivo pra detectar quando despausar.
        renderAll();
        return;
      }

      // Carregando normalmente: progressão lenta e suave, adequada pra um pitch de ~3min.
      // A cada tick, registra o kWh entregue ao veículo na fonte que estava realmente
      // ativa NESTE momento (e já consome a reserva solar na mesma proporção) — é isso
      // que garante a cobrança correta por fonte e a reserva sempre coerente.
      registrarConsumoPorFonte(1);
      appState.progressoPct = Math.min(100, appState.progressoPct + 1);
      renderAll();
    }, 700);
  }

  // Registra quanto do kWh entregue neste tick veio de Solar ou de Rede, E consome a
  // reserva solar na MESMA proporção — sem multiplicador artificial. 60 kWh de reserva
  // representam exatamente 3 cargas completas de 20 kWh: 20 kWh entregues da reserva
  // solar tiram exatamente 20 kWh da reserva, nunca mais nem menos.
  function registrarConsumoPorFonte(deltaPct){
    if (!appState.energiaDesejada) return;
    const deltaKwh = appState.energiaDesejada * (deltaPct / 100);
    const usandoSolarAgora = appState.solarOn && !appState.solarEsgotado &&
      appState.meuFonteTxt && appState.meuFonteTxt.indexOf('Solar') !== -1;

    if (usandoSolarAgora) {
      // Nunca consome mais reserva do que existe — se ela acabar no meio deste tick,
      // o restante desse kWh é automaticamente contabilizado como rede, no mesmo instante.
      const daReserva = Math.min(deltaKwh, appState.reservaSolarKwh);
      appState.energiaSolarConsumida = Math.min(appState.energiaDesejada, appState.energiaSolarConsumida + daReserva);
      appState.reservaSolarKwh = Math.max(0, appState.reservaSolarKwh - daReserva);

      const restanteParaRede = deltaKwh - daReserva;
      if (restanteParaRede > 0) {
        appState.energiaRedeConsumida = Math.min(appState.energiaDesejada, appState.energiaRedeConsumida + restanteParaRede);
      }
      if (appState.reservaSolarKwh <= 0 && !appState.solarEsgotado) {
        appState.solarEsgotado = true;
        appState.mostrarAvisoSolarEsgotado = true;
        recalcularMinhaSessao(); // recalcula potência/fonte/tarifa agora que a capacidade caiu
      }
    } else {
      appState.energiaRedeConsumida = Math.min(appState.energiaDesejada, appState.energiaRedeConsumida + deltaKwh);
    }
  }

  // Total cobrado na sessão: Urgente mantém tarifa fixa (paga pela prioridade, não pela
  // fonte). Economizar cobra cada kWh pela tarifa da fonte que realmente o entregou.
  function calcularTotalSessao(){
    if (!appState.energiaDesejada) return 0;
    if (appState.meuModo === 'urgente') return appState.energiaDesejada * TARIFA_URGENTE;
    return (appState.energiaSolarConsumida * TARIFA_SOLAR) + (appState.energiaRedeConsumida * TARIFA_REDE);
  }

  function pararAnimacaoBateria(){
    if (chargingInterval) { clearInterval(chargingInterval); chargingInterval = null; }
  }

  // ---------- Reserva solar simulada ----------
  // Capacidade real da reserva: 60 kWh = exatamente 3 cargas completas de 20 kWh.
  // Sem multiplicador artificial — o consumo é 1:1 com o kWh realmente entregue ao
  // veículo (ver registrarConsumoPorFonte, que também faz a depleção).
  const RESERVA_SOLAR_CAPACIDADE_KWH = 60;

  // Nível de cor da bateria visual — mesma regra em todo lugar que ela aparece.
  function nivelBateria(pct){
    if (pct <= 0) return 'level-empty';
    if (pct >= 50) return 'level-high';
    if (pct >= 20) return 'level-mid';
    return 'level-low';
  }

  // Fonte única que atualiza a bateria visual da reserva solar nos três lugares onde
  // ela aparece (admin, tela de energia do usuário, indicador compacto da recarga).
  //
  // IMPORTANTE: appState.reservaSolarKwh guarda o valor REAL da reserva (só muda com o
  // consumo de verdade durante a recarga). Mas quando o admin desliga o solar manualmente,
  // a EXIBIÇÃO precisa mostrar 0% / 0 kWh imediatamente — a energia armazenada continua
  // lá "guardada", só não está sendo usada/gerada agora. Por isso separamos:
  // reservaReal (o que fica guardado) de reservaExibida (o que aparece na tela).
  function atualizarVisualReservaSolar(){
    const reservaReal = appState.reservaSolarKwh;
    const reservaExibida = appState.solarOn ? reservaReal : 0;

    const reservaPct = Math.max(0, Math.round((reservaExibida / RESERVA_SOLAR_CAPACIDADE_KWH) * 100));
    const nivel = nivelBateria(reservaPct);
    const qtdRef = appState.energiaDesejada || 20;
    const cargas = Math.floor(reservaExibida / qtdRef);
    const restante = +(reservaExibida - (cargas * qtdRef)).toFixed(0);
    const cargasTxt = '≈ ' + cargas + ' carga' + (cargas===1?'':'s') + ' de ' + qtdRef + ' kWh';

    // Admin
    const admFill = document.getElementById('reservaSolarBatteryFill');
    admFill.style.width = reservaPct + '%';
    admFill.className = 'battery-fill ' + nivel;
    const admPct = document.getElementById('reservaSolarPctBig');
    admPct.textContent = reservaPct + '%';
    admPct.className = 'battery-pct-big ' + nivel;
    document.getElementById('reservaSolarKwhTxt').textContent = reservaExibida.toFixed(0) + ' kWh';
    document.getElementById('reservaSolarCargasTxt').textContent = cargasTxt;
    document.getElementById('reservaSolarRestanteTxt').textContent = restante + ' kWh';

    // Usuário — tela de Energia
    const uFill = document.getElementById('uReservaSolarBatteryFill');
    uFill.style.width = reservaPct + '%';
    uFill.className = 'battery-fill ' + nivel;
    const uPct = document.getElementById('uReservaSolarPctBig');
    uPct.textContent = reservaPct + '%';
    uPct.className = 'battery-pct-big ' + nivel;
    document.getElementById('uReservaSolarKwhTxt').textContent = reservaExibida.toFixed(0) + ' kWh';
    document.getElementById('uReservaSolarCargasTxt').textContent = cargasTxt;

    // Usuário — indicador compacto na tela de Recarga
    const miniFill = document.getElementById('uMiniReservaFill');
    miniFill.style.width = reservaPct + '%';
    miniFill.className = 'battery-fill-mini ' + nivel;
    document.getElementById('uMiniReservaTxt').textContent = reservaPct + '%';
    document.getElementById('uMiniReservaRow').classList.toggle('hidden', !appState.solarOn);
  }

  function alocarSessoes(sessions, capacidade){
    const urgentSessions = sessions.filter(s => s.tipo === 'urgente');
    const ecoSessions = sessions.filter(s => s.tipo === 'economizar');
    const urgentCount = urgentSessions.length;
    const ecoCount = ecoSessions.length;
    const urgentDemand = urgentCount * POT_URGENTE;
    const ecoDemandFull = ecoCount * POT_ECONOMIZAR;
    const result = {}; let nivel = 'ok';
    if (urgentCount > 0 && urgentDemand > capacidade) {
      const each = capacidade / urgentCount;
      urgentSessions.forEach(s => result[s.id] = { power: each, pausado:false });
      ecoSessions.forEach(s => result[s.id] = { power:0, pausado:true });
      nivel = 'critico';
    } else {
      urgentSessions.forEach(s => result[s.id] = { power: POT_URGENTE, pausado:false });
      const remaining = Math.max(capacidade - urgentDemand, 0);
      if (ecoCount === 0) nivel = 'ok';
      else if (remaining >= ecoDemandFull) { ecoSessions.forEach(s => result[s.id] = { power: POT_ECONOMIZAR, pausado:false }); nivel = 'ok'; }
      else {
        const maxServable = Math.floor(remaining / POT_MIN_ECONOMIZAR);
        if (maxServable <= 0) { ecoSessions.forEach(s => result[s.id] = { power:0, pausado:true }); nivel = 'eco-pausado'; }
        else if (maxServable >= ecoCount) { const each = remaining/ecoCount; ecoSessions.forEach(s => result[s.id] = { power: each, pausado:false }); nivel = 'eco-reduzido'; }
        else { const each = remaining/maxServable; ecoSessions.forEach((s,idx)=>{ result[s.id] = idx<maxServable ? {power:each,pausado:false} : {power:0,pausado:true}; }); nivel = 'eco-parcial'; }
      }
    }
    return { result, nivel, urgentDemand, ecoDemandFull: ecoCount*POT_ECONOMIZAR };
  }

  function sessoesAtuais(incluirEv2){
    // Vaga 01 é uma sessão real, sempre ocupada (Urgente, 11 kW) — ela consome parte da
    // capacidade da estação de verdade, e por isso PRECISA entrar no cálculo. A diferença
    // em relação a antes é que agora ela também aparece de forma explícita no admin
    // (📋 Sessões ativas), então não é mais uma sessão "fantasma" escondida.
    const s = [{ id:'vaga1', tipo:'urgente' }];
    if (appState.meuModo) s.push({ id:'meu', tipo: appState.meuModo });
    if (incluirEv2 && appState.ev2Modo) s.push({ id:'ev2', tipo: appState.ev2Modo });
    return s;
  }

  function formatTempo(horas){
    if (!isFinite(horas) || horas <= 0) return '—';
    const h = Math.floor(horas); const m = Math.round((horas-h)*60);
    return h>0 ? ('≈ '+h+'h'+(m>0?m+'min':'')) : ('≈ '+m+'min');
  }

  // ================= AÇÕES (mutam o estado e re-renderizam tudo) =================
  function toggleSolar(){
    if (appState.solarEsgotado) return; // reserva zerada — o botão fica travado até reiniciar
    appState.solarOn = !appState.solarOn;
    recalcularMinhaSessao();
    renderAll();
  }

  function fecharAvisoSolarEsgotado(){
    appState.mostrarAvisoSolarEsgotado = false;
    renderAll();
  }

  function recalcularMinhaSessao(){
    if (!appState.meuModo) return;
    const capacidade = capacidadeAtual();
    const alloc = alocarSessoes(sessoesAtuais(appState.ev2Active), capacidade);
    const meu = alloc.result['meu'];
    if (!meu) return;
    appState.meuPower = meu.pausado ? 0 : meu.power;
    // Fonte/tarifa nunca podem considerar o solar "ativo" se a reserva já esgotou,
    // mesmo que o interruptor solarOn continue ligado (o admin não desligou manualmente).
    const solarAtivo = appState.solarOn && !appState.solarEsgotado;
    const fonte = solarAtivo ? 'Solar + Rede' : 'Rede';
    if (appState.meuModo === 'urgente') {
      appState.meuTarifa = TARIFA_URGENTE;
      appState.meuFonteTxt = meu.pausado ? '—' : fonte;
    } else {
      appState.meuTarifa = solarAtivo ? TARIFA_SOLAR : TARIFA_REDE;
      appState.meuFonteTxt = meu.pausado ? '—' : (solarAtivo ? '☀️ Solar + Rede' : '🔌 Rede');
    }
    // EV-02, se já estiver ativo, também precisa ser recalculado — a mudança do solar
    // afeta a capacidade total, então a potência dele também pode subir ou descer.
    if (appState.ev2Active && appState.ev2Modo) {
      const ev2 = alloc.result['ev2'];
      if (ev2) appState.ev2Power = ev2.pausado ? 0 : ev2.power;
    }
  }

  function confirmarRFID(){
    const ring = document.getElementById('uRfidRing');
    ring.classList.add('scanning');
    setTimeout(function(){
      appState.rfidDone = true;
      document.getElementById('uRfidPre').classList.add('hidden');
      document.getElementById('uRfidPost').classList.remove('hidden');
      renderAll();
    }, 500);
  }

  function escolherQuantidade(qtd){
    appState.energiaDesejada = qtd;
    document.querySelectorAll('.u-qty-card').forEach(c => c.classList.toggle('selected', parseInt(c.dataset.qty)===qtd));
    document.getElementById('uQtyCustomInput').value = qtd;
    mostrarConfirmacaoQtd();
  }

  function qtyCustomChangeUser(){
    const v = parseFloat(document.getElementById('uQtyCustomInput').value);
    document.querySelectorAll('.u-qty-card').forEach(c => c.classList.remove('selected'));
    if (isFinite(v) && v > 0 && v <= 100) {
      appState.energiaDesejada = v;
      mostrarConfirmacaoQtd();
    } else {
      appState.energiaDesejada = null;
      document.getElementById('uQtyConfirmBox').classList.add('hidden');
      document.getElementById('btnQtyContinuar').disabled = true;
    }
  }

  function mostrarConfirmacaoQtd(){
    const box = document.getElementById('uQtyConfirmBox');
    box.textContent = appState.energiaDesejada + ' kWh selecionados';
    box.classList.remove('hidden');
    document.getElementById('btnQtyContinuar').disabled = false;
  }

  // Calcula tempo/tarifa de cada card ANTES do usuário escolher o modo, considerando
  // a Vaga 01 já ocupada e a energia escolhida — os números mudam se ele voltar e trocar a quantidade.
  function atualizarEstimativasEscolha(){
    if (!appState.energiaDesejada) return;
    const capacidade = capacidadeAtual();
    const allocU = alocarSessoes([{id:'vaga1',tipo:'urgente'},{id:'x',tipo:'urgente'}], capacidade).result['x'];
    const allocE = alocarSessoes([{id:'vaga1',tipo:'urgente'},{id:'x',tipo:'economizar'}], capacidade).result['x'];
    document.getElementById('estUrgenteQtyLabel').textContent = appState.energiaDesejada + ' kWh';
    document.getElementById('estEconomizarQtyLabel').textContent = appState.energiaDesejada + ' kWh';
    document.getElementById('estUrgenteTempo').textContent = formatTempo(appState.energiaDesejada / (allocU.power||POT_URGENTE));
    document.getElementById('estEconomizarTempo').textContent = allocE.pausado ? 'Indisponível agora' : formatTempo(appState.energiaDesejada / allocE.power);
    const solarAtivoEstimativa = appState.solarOn && !appState.solarEsgotado;
    document.getElementById('estEconomizarTarifa').textContent = 'R$ ' + (solarAtivoEstimativa?TARIFA_SOLAR:TARIFA_REDE).toFixed(2).replace('.',',') + '/kWh';
  }

  function escolherModoUsuario(modo){
    appState.meuModo = modo;
    appState.energiaSolarConsumida = 0;
    appState.energiaRedeConsumida = 0;
    userIrPara('ia');
    document.getElementById('uAiThinking').classList.remove('hidden');
    document.getElementById('uAiResult').classList.add('hidden');

    // Mensagens rotativas durante os ~1s de "análise" — só cosmético, não afeta o cálculo.
    const mensagens = ['Verificando capacidade', 'Analisando demanda', 'Avaliando energia solar', 'Comparando prioridades', 'Calculando distribuição ideal'];
    let mIdx = 0;
    const txtEl = document.getElementById('uAiThinkingTxt');
    const dotsHtml = '<span class="u-ai-dots"><span></span><span></span><span></span></span>';
    txtEl.innerHTML = mensagens[0] + dotsHtml;
    const msgInterval = setInterval(function(){
      mIdx = (mIdx + 1) % mensagens.length;
      txtEl.innerHTML = mensagens[mIdx] + dotsHtml;
    }, 220);

    setTimeout(function(){
      clearInterval(msgInterval);
      const capacidade = capacidadeAtual();
      const alloc = alocarSessoes(sessoesAtuais(false), capacidade);
      const meu = alloc.result['meu'];
      appState.meuPower = meu.pausado ? 0 : meu.power;
      // Mesma trava: solar só conta como "ativo" se ainda houver reserva de verdade.
      const solarAtivo = appState.solarOn && !appState.solarEsgotado;
      const fonte = solarAtivo ? 'Solar + Rede' : 'Rede';
      let decisaoTxt;
      if (modo === 'urgente') {
        appState.meuTarifa = TARIFA_URGENTE;
        appState.meuFonteTxt = meu.pausado ? '—' : fonte;
        decisaoTxt = 'Recarga urgente com prioridade máxima dentro da capacidade disponível, usando ' + fonte.toLowerCase() + '.';
      } else {
        appState.meuTarifa = solarAtivo ? TARIFA_SOLAR : TARIFA_REDE;
        appState.meuFonteTxt = meu.pausado ? '—' : (solarAtivo ? '☀️ Solar + Rede' : '🔌 Rede');
        decisaoTxt = solarAtivo
          ? 'Recarga econômica utilizando a capacidade disponível da estação.'
          : 'Recarga econômica utilizando a rede elétrica da estação (sem solar no momento).';
      }
      if (meu.pausado) decisaoTxt = 'Capacidade insuficiente no momento — sua recarga aguardará disponibilidade.';
      appState.aiDone = true;

      const tempoEstimado = meu.pausado ? 'Pausada' : formatTempo(appState.energiaDesejada/meu.power);
      document.getElementById('uAiFonte').textContent = meu.pausado ? '—' : fonte;
      document.getElementById('uAiPotencia').textContent = meu.pausado ? 'Pausada' : appState.meuPower.toFixed(1)+' kW';
      document.getElementById('uAiTempo').textContent = tempoEstimado;
      document.getElementById('uAiTarifa').textContent = 'R$ '+appState.meuTarifa.toFixed(2).replace('.',',')+'/kWh';
      document.getElementById('uAiDecisaoTxt').textContent = decisaoTxt;
      document.getElementById('uAiThinking').classList.add('hidden');
      document.getElementById('uAiResult').classList.remove('hidden');
      renderAll();
    }, 1000);
  }

  // Chamado pelo botão da Visão Geral — o seletor de Urgente/Economizar do EV-02 só
  // existe na aba Recargas, então trocamos de aba antes de abrir a simulação, senão
  // o usuário clica e "parece" que não aconteceu nada (a escolha abre numa aba escondida).
  function iniciarNovaChegadaDeGeral(){
    setAdminView('recarga');
    simularNovaChegada();
  }

  function simularNovaChegada(){
    appState.ev2Active = true;
    document.getElementById('admEv2Picker').classList.remove('hidden');
    document.getElementById('btnNovaChegada').disabled = true;
    document.getElementById('btnNovaChegadaGeral').disabled = true;
    renderAll();
  }

  function escolherModoEv2(modo){
    appState.ev2Modo = modo;
    const capacidade = capacidadeAtual();
    const alloc = alocarSessoes(sessoesAtuais(true), capacidade);
    let meu = alloc.result['meu'];
    const ev2 = alloc.result['ev2'];

    // TRAVA: minha potência jamais aumenta pela chegada do EV-02
    const antes = appState.meuPower;
    let depois = meu.power;
    let pausadoDepois = meu.pausado;
    if (!pausadoDepois && depois > antes + 0.001) depois = antes;

    appState.lastEv2Result = {
      antes, depois, pausadoDepois,
      ev2Power: ev2.pausado ? 0 : ev2.power, ev2Pausado: ev2.pausado,
      nivel: alloc.nivel
    };
    appState.meuPower = pausadoDepois ? 0 : depois;
    appState.ev2Power = ev2.pausado ? 0 : ev2.power;

    document.getElementById('admEv2Picker').classList.add('hidden');
    renderAll();
  }

  // Mapa explícito de ids — evita o bug de capitalização automática ('ia' virava 'Ia',
  // mas o elemento real é 'uIA'/'adminIA' com IA maiúsculo, gerando getElementById(null)
  // e o erro "Cannot read properties of null (reading 'classList')" ao navegar pra IA).
  const U_STEP_IDS = { vaga:'uVaga', rfid:'uRfid', energia:'uEnergia', quantidade:'uQuantidade', escolha:'uEscolha', ia:'uIA', recarga:'uRecarga', pagamento:'uPagamento' };
  const ADMIN_VIEW_IDS = { geral:'adminGeral', recarga:'adminRecarga', energia:'adminEnergia', ia:'adminIA', visao:'adminVisao' };

  function userIrPara(stepId){
    // Trava de segurança: nunca deixa finalizar/pagar uma recarga que não chegou a 100%.
    // O clique não faz nada (nem troca de tela) se a condição não for satisfeita — nunca
    // forçamos o progresso pra 100% artificialmente só porque o botão foi clicado.
    if (stepId === 'pagamento' && appState.progressoPct < 100) return;

    const cur = appState.userStep;
    document.getElementById(U_STEP_IDS[cur]).classList.add('hidden');
    appState.userStep = stepId;
    document.getElementById(U_STEP_IDS[stepId]).classList.remove('hidden');
    document.getElementById('uBackBtn').classList.toggle('show', stepId !== 'vaga');
    if (stepId === 'recarga' && !appState.chargingStarted) {
      appState.chargingStarted = true;
      iniciarAnimacaoBateria();
    }
    if (stepId === 'pagamento') {
      appState.paymentDone = true;
      pararAnimacaoBateria();
    }
    if (stepId === 'escolha') { atualizarEstimativasEscolha(); }
    renderAll();
  }

  const U_BACK_MAP = { rfid:'vaga', energia:'rfid', quantidade:'energia', escolha:'quantidade', ia:'escolha', recarga:'escolha', pagamento:'recarga' };
  function userVoltar(){ const alvo = U_BACK_MAP[appState.userStep]; if (alvo) userIrPara(alvo); }

  function setAdminView(view){
    appState.adminView = view;
    Object.keys(ADMIN_VIEW_IDS).forEach(v => document.getElementById(ADMIN_VIEW_IDS[v]).classList.toggle('hidden', v!==view));
    document.querySelectorAll('.admin-nav-item').forEach(el => el.classList.toggle('active', el.dataset.view===view));
    document.getElementById('adminCol').classList.toggle('visao-mode', view==='visao');
  }

  function setVisaoSub(sub){
    appState.visaoSub = sub;
    document.getElementById('visaoMenu').classList.toggle('hidden', !!sub);
    document.getElementById('visaoBusiness').classList.toggle('hidden', sub!=='business');
    document.getElementById('visaoDataflow').classList.toggle('hidden', sub!=='dataflow');
  }

  function reiniciar(){
    pararAnimacaoBateria();
    appState = {
      vaga:'02', usuario:'Gabriel', veiculo:'BYD Dolphin', rfidDone:false, solarOn:true,
      solarEsgotado:false, reservaSolarKwh:60, mostrarAvisoSolarEsgotado:false,
      energiaDesejada:null, meuModo:null, meuPower:null, meuTarifa:null, meuFonteTxt:'',
      energiaSolarConsumida:0, energiaRedeConsumida:0,
      aiDone:false, chargingStarted:false, progressoPct:4, ev2Active:false, ev2Modo:null, ev2Power:null,
      lastEv2Result:null, paymentDone:false, adminView:'geral', visaoSub:null, userStep:'vaga'
    };
    Object.keys(U_STEP_IDS).forEach(s => {
      document.getElementById(U_STEP_IDS[s]).classList.toggle('hidden', s!=='vaga');
    });
    document.getElementById('uBackBtn').classList.remove('show');
    document.getElementById('uRfidPre').classList.remove('hidden');
    document.getElementById('uRfidPost').classList.add('hidden');
    document.getElementById('uRfidRing').classList.remove('scanning');
    document.querySelectorAll('.u-qty-card').forEach(c => c.classList.remove('selected'));
    document.getElementById('uQtyCustomInput').value = '';
    document.getElementById('uQtyConfirmBox').classList.add('hidden');
    document.getElementById('btnQtyContinuar').disabled = true;
    document.getElementById('admEv2Picker').classList.add('hidden');
    document.getElementById('btnNovaChegada').disabled = true;
    document.getElementById('btnNovaChegadaGeral').disabled = true;
    document.getElementById('admCompareBox').classList.add('hidden');
    setAdminView('geral');
    setVisaoSub(null);
    renderAll();
  }

  // ================= RENDER (única fonte de verdade -> as duas telas) =================
  function renderAll(){ renderAdmin(); renderUser(); }

  function renderAdmin(){
    const capacidade = capacidadeAtual();
    const capMax = DISPONIVEL_EVS_BASE + CAP_BONUS_SOLAR;
    const alloc = alocarSessoes(sessoesAtuais(appState.ev2Active), capacidade);
    let demandaAtual = 0;
    Object.values(alloc.result).forEach(s => { if (!s.pausado) demandaAtual += s.power; });
    // Fonte única: solar só conta como "ativa de verdade" quando ligada E com reserva —
    // usado em todos os textos/valores desta função pra nunca mostrar +10kW indevido.
    const solarAtivoReal = appState.solarOn && !appState.solarEsgotado;

    // Estação
    document.getElementById('admCap').textContent = capacidade.toFixed(0)+' kW';
    document.getElementById('admDem').textContent = demandaAtual.toFixed(1)+' kW';
    document.getElementById('admSolarKw').textContent = (solarAtivoReal ? CAP_BONUS_SOLAR : 0)+' kW';
    document.getElementById('admCapBar').style.width = ((demandaAtual/capMax)*100).toFixed(0)+'%';
    const over = appState.ev2Active && appState.lastEv2Result && appState.lastEv2Result.nivel !== 'ok';
    document.getElementById('admSistemaStatus').textContent = over ? 'ALTA DEMANDA' : 'NORMAL';
    document.getElementById('admSistemaStatus').style.color = over ? 'var(--amber)' : 'var(--green)';

    // Indicador de demanda (🟢/🟡/🔴) baseado na razão demanda ÷ capacidade — nunca inventado.
    const razaoDemanda = capacidade > 0 ? demandaAtual / capacidade : 0;
    let demDot, demTxt;
    if (razaoDemanda >= 0.95) { demDot = '🔴'; demTxt = 'Demanda alta'; }
    else if (razaoDemanda >= 0.70) { demDot = '🟡'; demTxt = 'Atenção'; }
    else { demDot = '🟢'; demTxt = 'Demanda normal'; }
    document.getElementById('admDemandDot').textContent = demDot;
    document.getElementById('admDemandTxt').textContent = demTxt + ' (' + Math.round(razaoDemanda*100) + '% da capacidade)';

    // ---------- Visão Geral (dashboard principal) ----------
    document.getElementById('geralSolarKw').textContent = '☀️ +' + (solarAtivoReal ? CAP_BONUS_SOLAR : 0) + ' kW';
    document.getElementById('geralCapTxt').textContent = capacidade.toFixed(0) + ' kW disponíveis';
    document.getElementById('geralCapBar').style.width = ((capacidade/capMax)*100).toFixed(0) + '%';
    document.getElementById('geralCapSplit').innerHTML = '🔌 ' + DISPONIVEL_EVS_BASE + ' kW da rede <span class="plus">+</span> ☀️ ' + (solarAtivoReal ? CAP_BONUS_SOLAR : 0) + ' kW solar';
    document.getElementById('geralStatusPill').innerHTML = '<span class="status-pill-dot"></span>' + (over ? 'Alta demanda' : 'Normal');
    document.getElementById('geralStatusPill').style.color = over ? 'var(--amber)' : 'var(--green)';

    // Geração solar (mini card com sparkline decorativa)
    const solarAtivoAgora = appState.solarOn && !appState.solarEsgotado;
    document.getElementById('geralGeracaoSolar').textContent = solarAtivoAgora ? '+' + CAP_BONUS_SOLAR + ' kW' : '0 kW';
    document.getElementById('geralGeracaoSolar').className = 'mini-card-big' + (solarAtivoAgora ? ' pos' : '');
    document.getElementById('geralGeracaoStatus').textContent = appState.solarEsgotado ? 'Reserva esgotada' : (appState.solarOn ? 'Solar ativa' : 'Solar desativada');

    // Reserva solar (mesma bateria visual, mesma fonte de verdade da aba Energia)
    const reservaExibidaGeral = appState.solarOn ? appState.reservaSolarKwh : 0;
    const reservaPctGeral = Math.max(0, Math.round((reservaExibidaGeral / RESERVA_SOLAR_CAPACIDADE_KWH) * 100));
    const nivelGeral = nivelBateria(reservaPctGeral);
    document.getElementById('geralReservaFill').style.width = reservaPctGeral + '%';
    document.getElementById('geralReservaFill').className = 'battery-fill ' + nivelGeral;
    document.getElementById('geralReservaPct').textContent = reservaPctGeral + '%';
    document.getElementById('geralReservaPct').className = 'battery-pct-big ' + nivelGeral;
    document.getElementById('geralReservaKwh').textContent = reservaExibidaGeral.toFixed(0) + ' kWh disponíveis';
    const qtdRefGeral = appState.energiaDesejada || 20;
    const cargasGeral = Math.floor(reservaExibidaGeral / qtdRefGeral);
    document.getElementById('geralReservaCargas').textContent = '≈ ' + cargasGeral + ' carga' + (cargasGeral===1?'':'s') + ' de ' + qtdRefGeral + ' kWh';

    // Fluxo de energia (diagrama)
    document.getElementById('geralFluxoRede').textContent = DISPONIVEL_EVS_BASE + ' kW';
    document.getElementById('geralFluxoSolar').textContent = solarAtivoAgora ? '+' + CAP_BONUS_SOLAR + ' kW' : '0 kW';
    document.getElementById('geralFluxoSolar').className = solarAtivoAgora ? 'pos' : '';
    document.getElementById('geralFluxoEvs').textContent = demandaAtual.toFixed(1) + ' kW';
    document.getElementById('geralFluxoPill').innerHTML = '<span class="status-pill-dot"></span>' + (demandaAtual > 0 ? 'Ativa' : 'Ociosa');

    // Sessões — tabela (Vaga 01 fixa + Vaga 02 = EV-01/Gabriel + Vaga 03 = EV-02 quando ativo)
    const kwhConsumidaGeral = energiaConsumidaAtual();
    const pctGeral = appState.energiaDesejada ? Math.round((kwhConsumidaGeral/appState.energiaDesejada)*100) : 0;
    const vaga1 = alloc.result['vaga1'] || { power: 11, pausado:false };
    let rows = '';
    rows += '<tr><td><div class="st-vaga-num">01</div><div class="st-vaga-sub">Ocupada</div></td><td>' + VAGA1_VEICULO + '</td><td>⚡ Urgente</td><td>' + (vaga1.pausado?'0.0':vaga1.power.toFixed(1)) + ' kW</td><td><span class="st-badge ' + (vaga1.pausado?'paused':'charging') + '">' + (vaga1.pausado?'Pausada':'Carregando') + '</span></td><td>—</td></tr>';

    if (appState.meuModo && appState.meuPower !== null) {
      const statusCls = appState.paymentDone ? 'done' : (appState.meuPower>0 ? 'charging':'paused');
      const statusTxt = appState.paymentDone ? 'Finalizada' : (appState.meuPower>0 ? 'Carregando':'Pausada');
      rows += '<tr><td><div class="st-vaga-num">02</div><div class="st-vaga-sub">Ocupada</div></td><td>BYD Dolphin · Gabriel</td><td>' + (appState.meuModo==='urgente'?'⚡ Urgente':'🌱 Economizar') + '</td><td>' + appState.meuPower.toFixed(1) + ' kW</td><td><span class="st-badge ' + statusCls + '">' + statusTxt + '</span></td><td><div class="st-progress-track"><div class="st-progress-fill" style="width:' + pctGeral + '%"></div></div>' + (appState.chargingStarted?pctGeral+'%':'—') + '</td></tr>';
    } else {
      rows += '<tr><td><div class="st-vaga-num">02</div><div class="st-vaga-sub">Livre</div></td><td>—</td><td>—</td><td>0 kW</td><td><span class="st-badge waiting">Aguardando</span></td><td>—</td></tr>';
    }

    if (appState.ev2Active && appState.ev2Modo) {
      rows += '<tr><td><div class="st-vaga-num">03</div><div class="st-vaga-sub">Ocupada</div></td><td>EV-02 · Simulação</td><td>' + (appState.ev2Modo==='urgente'?'⚡ Urgente':'🌱 Economizar') + '</td><td>' + appState.ev2Power.toFixed(1) + ' kW</td><td><span class="st-badge ' + (appState.ev2Power>0?'charging':'paused') + '">' + (appState.ev2Power>0?'Carregando':'Pausada') + '</span></td><td>—</td></tr>';
    } else {
      rows += '<tr><td><div class="st-vaga-num">03</div><div class="st-vaga-sub">Livre</div></td><td>—</td><td>—</td><td>0 kW</td><td><span class="st-badge waiting">Disponível</span></td><td>—</td></tr>';
    }
    document.getElementById('geralSessionsTableBody').innerHTML = rows;

    // Nova chegada button
    document.getElementById('btnNovaChegada').disabled = !appState.chargingStarted || appState.ev2Active;
    document.getElementById('btnNovaChegadaGeral').disabled = !appState.chargingStarted || appState.ev2Active;

    // Comparação EV-01 vs EV-02 (após escolha do EV-02)
    if (appState.lastEv2Result) {
      document.getElementById('admCompareBox').classList.remove('hidden');
      const r = appState.lastEv2Result;
      function statusInfo(before, after, pausado){
        if (pausado) return {txt:'Pausada ⏸', cls:'paused'};
        if (Math.abs(before-after) < 0.05) return {txt:(before>0?'Mantida ✓':'Mantida ✓'), cls:'maintained'};
        return {txt:'Ajustada ↓', cls:'adjusted'};
      }
      const sMeu = statusInfo(r.antes, r.depois, r.pausadoDepois);
      const potNovoNom = appState.ev2Modo==='urgente'?POT_URGENTE:POT_ECONOMIZAR;
      const sEv2 = statusInfo(potNovoNom, r.ev2Power, r.ev2Pausado);
      document.getElementById('admCompareRows').innerHTML = `
        <div class="cm-row"><div><div class="cm-name">EV-01 · ${appState.meuModo==='urgente'?'⚡ Urgente':'🌱 Economizar'}</div><div class="cm-power">${r.antes.toFixed(1)} <span class="arrow">→</span> ${r.pausadoDepois?'Pausada':r.depois.toFixed(1)+' kW'}</div></div><div class="cm-status ${sMeu.cls}">${sMeu.txt}</div></div>
        <div class="cm-row"><div><div class="cm-name">EV-02 · ${appState.ev2Modo==='urgente'?'⚡ Urgente':'🌱 Economizar'}</div><div class="cm-power">${r.ev2Pausado?'Pausada':r.ev2Power.toFixed(1)+' kW'}</div></div><div class="cm-status ${sEv2.cls}">${sEv2.txt}</div></div>
      `;
      const alertBox = document.getElementById('admAlertBox');
      if (over) { alertBox.className='alert-box'; alertBox.innerHTML = '⚠️ <span><b>Alta demanda</b> — o WeCharge redistribuiu a potência para caber na capacidade de '+capacidade.toFixed(0)+' kW.</span>'; }
      else { alertBox.className='alert-box ok'; alertBox.innerHTML = '✓ <span><b>Capacidade suficiente</b> — nenhuma redistribuição foi necessária.</span>'; }
    } else {
      document.getElementById('admCompareBox').classList.add('hidden');
    }

    // Sessões ativas
    if (appState.meuModo && appState.meuPower !== null) {
      const kwhConsumida = energiaConsumidaAtual();
      const pct = appState.energiaDesejada ? Math.round((kwhConsumida/appState.energiaDesejada)*100) : 0;
      const vaga1 = alloc.result['vaga1'] || { power: 11, pausado:false };
      const vaga1Ajustada = Math.abs(vaga1.power - 11) > 0.05 && !vaga1.pausado;
      let sessionsHtml = `
        <div class="session-row">
          <div class="session-top"><div class="session-name">Vaga 01 · ${VAGA1_VEICULO}</div><div class="session-badge ${vaga1.pausado?'paused':'charging'}">${vaga1.pausado?'PAUSADA':'CARREGANDO'}</div></div>
          <div class="session-stats">
            <div class="session-stat"><div class="sl">Modo</div><div class="sv">⚡ Urgente</div></div>
            <div class="session-stat"><div class="sl">Potência</div><div class="sv">${vaga1.pausado?'0.0':vaga1.power.toFixed(1)} kW</div></div>
            <div class="session-stat"><div class="sl">Status</div><div class="sv">${vaga1Ajustada?'Ajustada ↓':'Normal ✓'}</div></div>
          </div>
        </div>
        <div class="session-row">
          <div class="session-top"><div class="session-name">BYD Dolphin</div><div class="session-badge ${appState.paymentDone ? 'charging' : (estadoRecarga()==='pausada'?'paused':'charging')}">${appState.paymentDone?'FINALIZADA':(estadoRecarga()==='concluida'?'CONCLUÍDA':(estadoRecarga()==='pausada'?'PAUSADA':'CARREGANDO'))}</div></div>
          <div class="session-stats">
            <div class="session-stat"><div class="sl">Modo</div><div class="sv">${appState.meuModo==='urgente'?'⚡ Urgente':'🌱 Economizar'}</div></div>
            <div class="session-stat"><div class="sl">Potência</div><div class="sv">${appState.meuPower.toFixed(1)} kW</div></div>
            <div class="session-stat"><div class="sl">Energia</div><div class="sv">${appState.energiaDesejada||'—'} kWh</div></div>
            <div class="session-stat"><div class="sl">Progresso</div><div class="sv">${appState.chargingStarted?pct+'%':'—'}</div></div>
          </div>
        </div>`;
      if (appState.ev2Active && appState.ev2Modo) {
        sessionsHtml += `
        <div class="session-row">
          <div class="session-top"><div class="session-name">EV-02 · Simulação</div><div class="session-badge ${appState.ev2Power>0?'charging':'paused'}">${appState.ev2Power>0?'CARREGANDO':'PAUSADA'}</div></div>
          <div class="session-stats">
            <div class="session-stat"><div class="sl">Modo</div><div class="sv">${appState.ev2Modo==='urgente'?'⚡ Urgente':'🌱 Economizar'}</div></div>
            <div class="session-stat"><div class="sl">Potência</div><div class="sv">${appState.ev2Power.toFixed(1)} kW</div></div>
            <div class="session-stat"><div class="sl">Energia</div><div class="sv">${EV2_KWH_DEMO} kWh — demonstração</div></div>
          </div>
        </div>`;
      }
      document.getElementById('admSessions').innerHTML = sessionsHtml;
    } else {
      document.getElementById('admSessions').innerHTML = `
        <div class="session-row">
          <div class="session-top"><div class="session-name">Vaga 01 · ${VAGA1_VEICULO}</div><div class="session-badge charging">CARREGANDO</div></div>
          <div class="session-stats">
            <div class="session-stat"><div class="sl">Modo</div><div class="sv">⚡ Urgente</div></div>
            <div class="session-stat"><div class="sl">Potência</div><div class="sv">11.0 kW</div></div>
            <div class="session-stat"><div class="sl">Status</div><div class="sv">Normal ✓</div></div>
          </div>
        </div>
        <div class="session-empty">Aguardando motorista da Vaga 02 se identificar...</div>`;
    }

    // Energia (aba)
    document.getElementById('admEnergiaBar').style.width = ((capacidade/capMax)*100).toFixed(0)+'%';
    document.getElementById('admEnergiaBar').className = 'a-bar-fill'+(solarAtivoReal?'':' off');
    document.getElementById('admEnergiaTotalTxt').textContent = capacidade.toFixed(0)+' / '+capMax+' kW';
    document.getElementById('admSolarIcon').textContent = appState.solarEsgotado ? '☀️' : (appState.solarOn?'☀️':'☁️');
    document.getElementById('admSolarStatusTxt').textContent = appState.solarEsgotado ? 'ESGOTADA' : (appState.solarOn?'ATIVA':'INDISPONÍVEL');
    document.getElementById('admSolarStatusTxt').className = 'solar-status '+(solarAtivoReal?'on':'off');
    document.getElementById('admSolarSubTxt').textContent = appState.solarEsgotado
      ? 'Reserva esgotada — recarga continua pela rede'
      : (appState.solarOn ? 'Contribuindo +10 kW para a capacidade' : 'Solar: 0 kW — capacidade voltou para 20 kW');
    const btnSolar = document.getElementById('btnToggleSolar');
    btnSolar.textContent = appState.solarEsgotado ? 'Solar esgotado' : (appState.solarOn ? 'Desativar solar' : 'Ativar solar');
    btnSolar.disabled = appState.solarEsgotado;

    // Card compacto de Solar (aba Recarga) — mesmo estado, mesma função de toggle
    document.getElementById('admSolarIconMini').textContent = appState.solarEsgotado ? '☀️' : (appState.solarOn?'☀️':'☁️');
    document.getElementById('admSolarStatusMini').textContent = appState.solarEsgotado ? 'ESGOTADA' : (appState.solarOn?'ATIVA':'INDISPONÍVEL');
    document.getElementById('admSolarStatusMini').className = 'solar-status '+(solarAtivoReal?'on':'off');
    document.getElementById('admSolarSubMini').textContent = appState.solarEsgotado ? '0 kW · esgotada' : (appState.solarOn ? '+10 kW' : '0 kW');
    const btnSolarMini = document.getElementById('btnToggleSolarMini');
    btnSolarMini.textContent = appState.solarEsgotado ? 'Solar esgotado' : (appState.solarOn ? 'Desativar solar' : 'Ativar solar');
    btnSolarMini.disabled = appState.solarEsgotado;

    // Reserva solar simulada — atualiza admin, tela de energia do usuário e o indicador
    // compacto da tela de recarga, todos a partir do mesmo appState.reservaSolarKwh.
    atualizarVisualReservaSolar();

    // Aviso de transição Solar → Rede (aparece uma vez, o admin pode fechar)
    const avisoBox = document.getElementById('admSolarAviso');
    avisoBox.classList.toggle('hidden', !appState.mostrarAvisoSolarEsgotado);

    // IA (aba)
    if (appState.aiDone) {
      const fonte = appState.meuFonteTxt || (appState.solarOn?'Solar + Rede':'Rede');
      document.getElementById('admIaFonte').textContent = fonte;
      document.getElementById('admIaPotencia').textContent = appState.meuPower>0 ? appState.meuPower.toFixed(1)+' kW' : 'Pausada';
      document.getElementById('admIaTarifa').textContent = 'R$ '+(appState.meuTarifa||0).toFixed(2).replace('.',',')+'/kWh';

      const restanteIa = appState.energiaDesejada ? appState.energiaDesejada - energiaConsumidaAtual() : 0;
      const tempoIa = appState.meuPower>0 ? formatTempo(restanteIa/appState.meuPower) : 'Pausada';
      document.getElementById('admIaTempo').textContent = tempoIa;

      const nVeiculos = 1 + (appState.ev2Active && appState.ev2Modo ? 1 : 0) + 1; // EV-01 + EV-02 (se ativo) + Vaga 01
      document.getElementById('admIaVeiculos').textContent = nVeiculos;

      // Explicação dinâmica: monta a frase a partir dos dados reais do estado atual —
      // nunca um texto fixo que possa contradizer o cenário.
      let decisaoTxt;
      const houveRedistribuicao = appState.ev2Active && appState.lastEv2Result && appState.lastEv2Result.nivel !== 'ok';
      if (appState.solarEsgotado) {
        decisaoTxt = 'Reserva solar esgotada. A IA transferiu a recarga para a rede sem interromper o carregamento.';
      } else if (appState.meuPower <= 0) {
        decisaoTxt = nVeiculos + ' veículos conectados na estação, que possui ' + capacidade.toFixed(0) + ' kW de capacidade. Não há energia disponível no momento — sua recarga aguardará disponibilidade.';
      } else if (houveRedistribuicao) {
        const ev2Nome = appState.ev2Modo === 'urgente' ? 'prioridade urgente' : 'modo econômico';
        decisaoTxt = nVeiculos + ' veículos estão conectados. A estação possui ' + capacidade.toFixed(0) + ' kW disponíveis. O EV-02 entrou com ' + ev2Nome + '. A IA redistribuiu a potência para manter a demanda dentro da capacidade.';
      } else if (appState.ev2Active) {
        decisaoTxt = nVeiculos + ' veículos estão conectados e a capacidade disponível (' + capacidade.toFixed(0) + ' kW) é suficiente para atender todos sem alterar a potência de ninguém.';
      } else if (appState.meuModo === 'urgente') {
        decisaoTxt = 'Recarga urgente com prioridade máxima dentro da capacidade disponível (' + capacidade.toFixed(0) + ' kW), usando ' + fonte.toLowerCase() + '.';
      } else if (appState.solarOn) {
        decisaoTxt = 'Solar disponível no momento. A IA utiliza a geração solar para complementar a capacidade da estação (' + capacidade.toFixed(0) + ' kW no total).';
      } else {
        decisaoTxt = 'Recarga econômica utilizando a capacidade disponível da rede da estação (' + capacidade.toFixed(0) + ' kW, sem solar no momento).';
      }
      document.getElementById('admIaDecisaoTxt').textContent = decisaoTxt;
    } else {
      document.getElementById('admIaFonte').textContent='—'; document.getElementById('admIaPotencia').textContent='—'; document.getElementById('admIaTarifa').textContent='—';
      document.getElementById('admIaTempo').textContent='—'; document.getElementById('admIaVeiculos').textContent='—';
      document.getElementById('admIaDecisaoTxt').textContent = 'Aguardando o motorista escolher a quantidade e a prioridade de recarga.';
    }
  }

  function renderUser(){
    // Tela de energia (informativa — solar é controlado pelo admin)
    const capacidade = capacidadeAtual();
    const capMax = DISPONIVEL_EVS_BASE + CAP_BONUS_SOLAR;
    document.getElementById('uDisponivelKwDisplay').textContent = DISPONIVEL_EVS_BASE + ' kW';
    document.getElementById('uTotalKwDisplay').textContent = capacidade.toFixed(0) + ' kW';
    document.getElementById('uCapBarFill').style.width = ((capacidade/capMax)*100).toFixed(0)+'%';
    const solarAtivoUser = appState.solarOn && !appState.solarEsgotado;
    document.getElementById('uCapBarFill').className = 'u-cap-bar-fill'+(solarAtivoUser?'':' off');
    const uSolarTxt = document.getElementById('uCapBarSolarTxt');
    uSolarTxt.textContent = appState.solarEsgotado ? '☀️ Solar esgotada' : (appState.solarOn ? '☀️ Solar ativo' : '☁️ Solar indisponível');
    uSolarTxt.className = 'u-cap-bar-solar '+(solarAtivoUser?'on':'off');

    // Quantidade: mantém seleção visual coerente
    if (appState.energiaDesejada) {
      document.querySelectorAll('.u-qty-card').forEach(c => c.classList.toggle('selected', parseInt(c.dataset.qty)===appState.energiaDesejada));
    }

    // Escolha: recalcula tempo/tarifa se o solar mudar enquanto essa tela está aberta
    if (appState.userStep === 'escolha') atualizarEstimativasEscolha();

    // Pagamento: fonte usada na sessão
    if (appState.meuModo && appState.energiaDesejada) {
      document.getElementById('uPayFonte').textContent = appState.meuFonteTxt || '—';
    }

    // Tela de recarga
    if (appState.userStep === 'recarga' && appState.meuModo && appState.energiaDesejada) {
      const consumida = energiaConsumidaAtual();
      const pct = Math.round((consumida/appState.energiaDesejada)*100);
      const restante = appState.energiaDesejada - consumida;
      const tempoRestante = appState.meuPower>0 ? formatTempo(restante/appState.meuPower) : 'Pausada';

      document.getElementById('uChargePctNum').textContent = pct+'%';
      const circ = 2*Math.PI*51;
      const offset = circ - (circ*pct/100);
      document.getElementById('uChargePctCircle').style.strokeDasharray = circ.toFixed(0);
      document.getElementById('uChargePctCircle').style.strokeDashoffset = offset.toFixed(0);

      document.getElementById('uChargeModo').textContent = appState.meuModo==='urgente'?'⚡ Urgente':'🌱 Economizar';
      const potEl = document.getElementById('uChargePotencia');
      const novoTxt = appState.meuPower>0 ? appState.meuPower.toFixed(1)+' kW' : 'Pausada';
      if (potEl.textContent !== novoTxt) { potEl.classList.remove('flash'); void potEl.offsetWidth; potEl.classList.add('flash'); }
      potEl.textContent = novoTxt;
      document.getElementById('uChargeFonte').textContent = appState.meuFonteTxt;
      document.getElementById('uChargeTempo').textContent = tempoRestante;
      document.getElementById('uChargeEnergiaTotal').textContent = consumida+'/'+appState.energiaDesejada+' kWh';
      document.getElementById('uSolarKwhTxt').textContent = appState.energiaSolarConsumida.toFixed(1)+' kWh';
      document.getElementById('uRedeKwhTxt').textContent = appState.energiaRedeConsumida.toFixed(1)+' kWh';

      const estado = estadoRecarga();
      const statusBox = document.getElementById('uChargeStatusBox');
      if (estado === 'concluida') { statusBox.textContent='✓ Recarga concluída'; statusBox.className='u-charge-status'; }
      else if (estado === 'pausada') { statusBox.textContent='⏸ Recarga pausada temporariamente'; statusBox.className='u-charge-status warn'; }
      else { statusBox.textContent='⚡ Carregando...'; statusBox.className='u-charge-status'; }

      // Botão "Finalizar recarga e pagar" só fica ativo com a recarga em 100% —
      // enquanto isso, mostra o progresso real em vez de deixar parecer clicável.
      const btnFinalizar = document.getElementById('btnFinalizarPagar');
      if (estado === 'concluida') {
        btnFinalizar.disabled = false;
        btnFinalizar.textContent = 'Finalizar recarga e pagar';
      } else {
        btnFinalizar.disabled = true;
        btnFinalizar.textContent = 'Recarga em andamento… ' + Math.round(pct) + '%';
      }

      document.getElementById('uSolarNoticeBox').classList.toggle('show', appState.mostrarAvisoSolarEsgotado);

      const pctNumEl = document.getElementById('uChargePctNum');
      pctNumEl.classList.toggle('done', estado === 'concluida');
      document.getElementById('uChargePctCircle').classList.toggle('charging', estado === 'carregando');
      document.getElementById('uChargePctLabel').textContent = estado === 'concluida' ? 'concluído ✓' : 'carregado';

      // Notice de nova chegada (visível só se houve mudança real)
      const notice = document.getElementById('uNoticeBox');
      if (appState.lastEv2Result) {
        const r = appState.lastEv2Result;
        if (Math.abs(r.antes - (r.pausadoDepois?0:r.depois)) > 0.05) {
          document.getElementById('uNoticeTxt').textContent = 'Sua potência foi ajustada: '+r.antes.toFixed(1)+' → '+(r.pausadoDepois?'pausada':r.depois.toFixed(1)+' kW')+' (alta demanda na estação)';
        } else {
          document.getElementById('uNoticeTxt').textContent = 'Nova demanda detectada — sua potência foi mantida';
        }
        notice.classList.add('show');
      } else {
        notice.classList.remove('show');
      }
    }

    // Pagamento: recalculado sempre que houver escolha de energia/tarifa, independente da
    // etapa atual — evita valores desatualizados se algo mudar (ex: solar) enquanto a
    // tela de pagamento já estiver aberta.
    if (appState.meuModo && appState.energiaDesejada) {
      document.getElementById('uPayKwh').textContent = appState.energiaDesejada+' kWh';
      document.getElementById('uPayTotal').textContent = 'R$ '+calcularTotalSessao().toFixed(2).replace('.',',');

      if (appState.meuModo === 'urgente') {
        document.getElementById('uEstratoUrgente').classList.remove('hidden');
        document.getElementById('uEstratoSplit').classList.add('hidden');
        document.getElementById('uPayTarifaUrgente').textContent = 'R$ '+TARIFA_URGENTE.toFixed(2).replace('.',',')+'/kWh';
      } else {
        document.getElementById('uEstratoUrgente').classList.add('hidden');
        document.getElementById('uEstratoSplit').classList.remove('hidden');
        const solarKwh = appState.energiaSolarConsumida;
        const redeKwh = appState.energiaRedeConsumida;
        document.getElementById('uEstratoSolarCalc').textContent = solarKwh.toFixed(1)+' kWh × R$ '+TARIFA_SOLAR.toFixed(2).replace('.',',');
        document.getElementById('uEstratoSolarSub').textContent = 'R$ '+(solarKwh*TARIFA_SOLAR).toFixed(2).replace('.',',');
        document.getElementById('uEstratoRedeCalc').textContent = redeKwh.toFixed(1)+' kWh × R$ '+TARIFA_REDE.toFixed(2).replace('.',',');
        document.getElementById('uEstratoRedeSub').textContent = 'R$ '+(redeKwh*TARIFA_REDE).toFixed(2).replace('.',',');
      }
    }
  }

  document.addEventListener('DOMContentLoaded', renderAll);
</script>

</body>
</html>
